<mxfile host="drawio">
  <diagram id="keycloak-login-flowchart" name="Keycloak login">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="700" pageHeight="1320" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="lane_client" value="PrepMeUp client (customer app or admin panel)" style="rounded=1;arcSize=18;absoluteArcSize=1;swimlane;html=1;startSize=30;horizontal=1;whiteSpace=wrap;collapsible=0;fillColor=#E8F0EE;swimlaneFillColor=#FFFFFF;strokeColor=#173330;fontColor=#173330;fontStyle=1;fontSize=13;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="442" height="1220" as="geometry"/></mxCell>
        <mxCell id="lane_kc" value="Keycloak (realm prepmeup)" style="rounded=1;arcSize=18;absoluteArcSize=1;swimlane;html=1;startSize=30;horizontal=1;whiteSpace=wrap;collapsible=0;fillColor=#E8F0EE;swimlaneFillColor=#FFFFFF;strokeColor=#173330;fontColor=#173330;fontStyle=1;fontSize=13;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="442" y="0" width="468" height="1220" as="geometry"/></mxCell>
        
        <mxCell id="node_click" value="1. Start the login" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#173330;fontColor=#173330;fontSize=12;fontFamily=Arial;spacingLeft=4;spacingRight=4;" vertex="1" parent="lane_client"><mxGeometry x="20" y="118" width="286" height="50" as="geometry"/></mxCell><mxCell id="actor_user" value="User" style="shape=umlActor;verticalLabelPosition=middle;labelPosition=left;align=right;verticalAlign=middle;spacingRight=6;html=1;outlineConnect=0;fillColor=#FFFFFF;strokeColor=#173330;fontColor=#173330;fontSize=12;fontStyle=1;" vertex="1" parent="lane_client"><mxGeometry x="149" y="38" width="28" height="48" as="geometry"/></mxCell><mxCell id="fc_actor" value="clicks Sign in" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;strokeColor=#173330;fontColor=#173330;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="lane_client" source="actor_user" target="node_click"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="node_pkce_gen" value="2. Generate PKCE and state:&lt;br&gt;&#8226; code_verifier (random)&lt;br&gt;&#8226; code_challenge = SHA256(code_verifier)&lt;br&gt;&#8226; a random state value" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#173330;fontColor=#173330;fontSize=12;fontFamily=Arial;spacingLeft=4;spacingRight=4;" vertex="1" parent="lane_client"><mxGeometry x="20" y="196" width="286" height="62" as="geometry"/></mxCell>
        <mxCell id="node_open_browser" value="3. Open the Keycloak login page with client_id, redirect_uri, code_challenge and state" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#173330;fontColor=#173330;fontSize=12;fontFamily=Arial;spacingLeft=4;spacingRight=4;" vertex="1" parent="lane_client"><mxGeometry x="20" y="286" width="286" height="78" as="geometry"/></mxCell>
        <mxCell id="node_kc_display" value="4. Show the Keycloak login page (email and password)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#173330;fontColor=#173330;fontSize=12;fontFamily=Arial;spacingLeft=4;spacingRight=4;" vertex="1" parent="lane_kc"><mxGeometry x="20" y="297" width="286" height="56" as="geometry"/></mxCell>
        <mxCell id="node_kc_submit" value="5. The user enters email and password and submits the form" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#173330;fontColor=#173330;fontSize=12;fontFamily=Arial;spacingLeft=4;spacingRight=4;" vertex="1" parent="lane_kc"><mxGeometry x="20" y="381" width="286" height="56" as="geometry"/></mxCell>
        <mxCell id="node_kc_dec_creds" value="6. Are email and password correct?" style="spacing=14;rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#173330;fontColor=#173330;fontSize=12;fontFamily=Arial;spacing=0;" vertex="1" parent="lane_kc"><mxGeometry x="37" y="460" width="250" height="100" as="geometry"/></mxCell>
        <mxCell id="node_kc_err_creds" value="Show an error on the login page" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#173330;fontColor=#173330;fontSize=12;fontFamily=Arial;spacingLeft=4;spacingRight=4;" vertex="1" parent="lane_kc"><mxGeometry x="328" y="409" width="125" height="56" as="geometry"/></mxCell>
        <mxCell id="node_kc_gen_code" value="7. Create an SSO session and issue a one-time authorization code" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#173330;fontColor=#173330;fontSize=12;fontFamily=Arial;spacingLeft=4;spacingRight=4;" vertex="1" parent="lane_kc"><mxGeometry x="20" y="588" width="286" height="62" as="geometry"/></mxCell>
        <mxCell id="node_kc_redirect" value="8. Redirect the browser to redirect_uri with code and state" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#173330;fontColor=#173330;fontSize=12;fontFamily=Arial;spacingLeft=4;spacingRight=4;" vertex="1" parent="lane_kc"><mxGeometry x="20" y="683" width="286" height="62" as="geometry"/></mxCell>
        <mxCell id="node_client_callback" value="8. Receive the redirect and read code and state" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#173330;fontColor=#173330;fontSize=12;fontFamily=Arial;spacingLeft=4;spacingRight=4;" vertex="1" parent="lane_client"><mxGeometry x="20" y="686" width="286" height="56" as="geometry"/></mxCell>
        <mxCell id="node_client_dec_state" value="9. Does state match the stored value?" style="spacing=14;rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#173330;fontColor=#173330;fontSize=12;fontFamily=Arial;spacing=0;" vertex="1" parent="lane_client"><mxGeometry x="42" y="773" width="240" height="100" as="geometry"/></mxCell>
        <mxCell id="node_client_err_csrf" value="Stop the login (no token request)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F6E3E1;strokeColor=#8A2F25;fontColor=#8A2F25;fontSize=12;fontFamily=Arial;spacingLeft=2;spacingRight=2;" vertex="1" parent="lane_client"><mxGeometry x="312" y="795" width="120" height="56" as="geometry"/></mxCell>
        
        <mxCell id="node_client_post_token" value="10. POST /token with code and code_verifier" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#173330;fontColor=#173330;fontSize=12;fontFamily=Arial;spacingLeft=4;spacingRight=4;" vertex="1" parent="lane_client"><mxGeometry x="20" y="913" width="286" height="62" as="geometry"/></mxCell>
        <mxCell id="node_kc_dec_pkce" value="11. Does SHA256(code_verifier) match code_challenge?" style="spacing=14;rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#173330;fontColor=#173330;fontSize=12;fontFamily=Arial;spacing=0;" vertex="1" parent="lane_kc"><mxGeometry x="27" y="892" width="270" height="104" as="geometry"/></mxCell>
        <mxCell id="node_kc_err_pkce" value="Answer 400 Bad Request (invalid_grant)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F6E3E1;strokeColor=#8A2F25;fontColor=#8A2F25;fontSize=12;fontFamily=Arial;spacingLeft=2;spacingRight=2;" vertex="1" parent="lane_kc"><mxGeometry x="328" y="913" width="125" height="62" as="geometry"/></mxCell>
        
        <mxCell id="node_kc_issue_tokens" value="12. Issue tokens:&lt;br&gt;&#8226; access token, a JWT for prepmeup-api&lt;br&gt;&#8226; ID token and refresh token" style="strokeWidth=2;rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E8F0EE;strokeColor=#173330;fontColor=#173330;fontSize=12;fontFamily=Arial;spacingLeft=4;spacingRight=4;" vertex="1" parent="lane_kc"><mxGeometry x="20" y="1036" width="286" height="62" as="geometry"/></mxCell>
        <mxCell id="node_client_save_token" value="13. Store the tokens and update the auth state" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#173330;fontColor=#173330;fontSize=12;fontFamily=Arial;spacingLeft=4;spacingRight=4;" vertex="1" parent="lane_client"><mxGeometry x="20" y="1036" width="286" height="62" as="geometry"/></mxCell>
        <mxCell id="node_client_finish" value="14. The user is signed in" style="strokeWidth=2;rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E8F0EE;strokeColor=#173330;fontColor=#173330;fontSize=12;fontFamily=Arial;spacingLeft=4;spacingRight=4;" vertex="1" parent="lane_client"><mxGeometry x="20" y="1134" width="286" height="50" as="geometry"/></mxCell>
        
        
        <mxCell id="fc_e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=open;endSize=10;strokeColor=#173330;fontColor=#173330;fontSize=11;fontFamily=Arial;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="node_click" target="node_pkce_gen"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="fc_e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=open;endSize=10;strokeColor=#173330;fontColor=#173330;fontSize=11;fontFamily=Arial;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="node_pkce_gen" target="node_open_browser"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="fc_e3" value="Redirect to Keycloak" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=open;endSize=10;strokeColor=#173330;fontColor=#173330;fontSize=11;fontFamily=Arial;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="node_open_browser" target="node_kc_display"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="fc_e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=open;endSize=10;strokeColor=#173330;fontColor=#173330;fontSize=11;fontFamily=Arial;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="node_kc_display" target="node_kc_submit"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="fc_e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=open;endSize=10;strokeColor=#173330;fontColor=#173330;fontSize=11;fontFamily=Arial;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="node_kc_submit" target="node_kc_dec_creds"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="fc_e6_no" value="[no]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=open;endSize=10;strokeColor=#173330;fontColor=#173330;fontSize=11;fontFamily=Arial;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="node_kc_dec_creds" target="node_kc_err_creds"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="832" y="510"/></Array></mxGeometry></mxCell>
        <mxCell id="fc_e6_retry" value="Try again" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=open;endSize=10;strokeColor=#173330;fontColor=#173330;fontSize=11;fontFamily=Arial;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="node_kc_err_creds" target="node_kc_display"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="832" y="325"/></Array></mxGeometry></mxCell>
        <mxCell id="fc_e6_yes" value="[yes]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=open;endSize=10;strokeColor=#173330;fontColor=#173330;fontSize=11;fontFamily=Arial;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="node_kc_dec_creds" target="node_kc_gen_code"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="fc_e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=open;endSize=10;strokeColor=#173330;fontColor=#173330;fontSize=11;fontFamily=Arial;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="node_kc_gen_code" target="node_kc_redirect"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="fc_e8" value="code and state" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=open;endSize=10;strokeColor=#173330;fontColor=#173330;fontSize=11;fontFamily=Arial;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="node_kc_redirect" target="node_client_callback"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="fc_e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=open;endSize=10;strokeColor=#173330;fontColor=#173330;fontSize=11;fontFamily=Arial;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="node_client_callback" target="node_client_dec_state"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="fc_e10_no" value="[no]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=open;endSize=10;strokeColor=#173330;fontColor=#173330;fontSize=11;fontFamily=Arial;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="node_client_dec_state" target="node_client_err_csrf"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        
        <mxCell id="fc_e10_yes" value="[yes]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=open;endSize=10;strokeColor=#173330;fontColor=#173330;fontSize=11;fontFamily=Arial;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="node_client_dec_state" target="node_client_post_token"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="fc_e11" value="code, code_verifier" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=open;endSize=10;strokeColor=#173330;fontColor=#173330;fontSize=11;fontFamily=Arial;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="node_client_post_token" target="node_kc_dec_pkce"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="fc_e12_no" value="[no]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=open;endSize=10;strokeColor=#173330;fontColor=#173330;fontSize=11;fontFamily=Arial;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="node_kc_dec_pkce" target="node_kc_err_pkce"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        
        <mxCell id="fc_e12_yes" value="[yes]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=open;endSize=10;strokeColor=#173330;fontColor=#173330;fontSize=11;fontFamily=Arial;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="node_kc_dec_pkce" target="node_kc_issue_tokens"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="fc_e13" value="tokens" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=open;endSize=10;strokeColor=#173330;fontColor=#173330;fontSize=11;fontFamily=Arial;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="node_kc_issue_tokens" target="node_client_save_token"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="fc_e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=open;endSize=10;strokeColor=#173330;fontColor=#173330;fontSize=11;fontFamily=Arial;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="node_client_save_token" target="node_client_finish"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        
        <mxCell id="legend" value="Legend" style="rounded=1;arcSize=18;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#173330;align=left;verticalAlign=top;container=1;collapsible=0;fontSize=11;fontStyle=1;fontColor=#173330;fontFamily=Arial;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="0" y="1234" width="910" height="62" as="geometry"/></mxCell>
        
        
        
        
        <mxCell id="legend_sym2" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#173330;fontColor=#173330;fontSize=12;fontFamily=Arial;spacingLeft=4;spacingRight=4;" vertex="1" parent="legend"><mxGeometry x="10" y="30" width="34" height="20" as="geometry"/></mxCell>
        <mxCell id="legend_txt2" value="Action" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#173330;fontFamily=Arial;" vertex="1" parent="legend"><mxGeometry x="48" y="24" width="42" height="32" as="geometry"/></mxCell>
        <mxCell id="legend_sym3" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F6E3E1;strokeColor=#8A2F25;fontColor=#8A2F25;fontSize=12;fontFamily=Arial;spacingLeft=2;spacingRight=2;" vertex="1" parent="legend"><mxGeometry x="98" y="30" width="34" height="20" as="geometry"/></mxCell>
