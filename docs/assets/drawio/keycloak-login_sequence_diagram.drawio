<mxfile host="drawio"><diagram id="keycloak-login-sequence" name="Keycloak login sequence">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="700" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="user" value="User" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;participant=umlActor;verticalAlign=bottom;spacingBottom=-16;labelBackgroundColor=#FFFFFF;fillColor=#FFFFFF;strokeColor=#173330;fontColor=#173330;fontSize=12;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="80.0" y="40" width="40" height="898" as="geometry" />
        </mxCell>
        <mxCell id="client" value=":Customer app&lt;br&gt;or Admin panel" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;fillColor=#FFFFFF;strokeColor=#173330;fontColor=#173330;fontSize=12;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="240" y="40" width="120" height="898" as="geometry" />
        </mxCell>
        <mxCell id="kc" value=":Keycloak" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;fillColor=#FFFFFF;strokeColor=#173330;fontColor=#173330;fontSize=12;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="440" y="40" width="120" height="898" as="geometry" />
        </mxCell>
        <mxCell id="act0" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#ffffff;strokeColor=#173330;" vertex="1" parent="kc">
          <mxGeometry x="55" y="202" width="10" height="48" as="geometry" />
        </mxCell>
        <mxCell id="act1" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#ffffff;strokeColor=#173330;" vertex="1" parent="kc">
          <mxGeometry x="55" y="298" width="10" height="176" as="geometry" />
        </mxCell>
        <mxCell id="act2" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#ffffff;strokeColor=#173330;" vertex="1" parent="kc">
          <mxGeometry x="55" y="586" width="10" height="112" as="geometry" />
        </mxCell>
        <mxCell id="act3" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#ffffff;strokeColor=#173330;" vertex="1" parent="client">
          <mxGeometry x="55" y="90" width="10" height="720" as="geometry" />
        </mxCell>
        <mxCell id="m0" value="1. Click Sign in" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.1002;entryX=0;entryY=0.0;strokeColor=#173330;fontColor=#173330;fontSize=11;fontFamily=Arial;labelBackgroundColor=#FFFFFF;endSize=8;" edge="1" parent="1" source="user" target="act3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m1" value="2. Generate PKCE&lt;br&gt;values and state" style="html=1;verticalAlign=middle;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.0667;entryX=1;entryY=0.1083;strokeColor=#173330;fontColor=#173330;fontSize=11;fontFamily=Arial;labelBackgroundColor=#FFFFFF;endSize=8;" edge="1" parent="1" source="act3" target="act3">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="360" y="178" /><mxPoint x="360" y="208" /></Array>
          <mxPoint x="58" y="0" as="offset" /></mxGeometry>
        </mxCell>
        <mxCell id="m2" value="3. GET /auth with client_id,&lt;br&gt;redirect_uri, code_challenge, state" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.1556;entryX=0;entryY=0.0;strokeColor=#173330;fontColor=#173330;fontSize=11;fontFamily=Arial;labelBackgroundColor=#FFFFFF;endSize=8;" edge="1" parent="1" source="act3" target="act0">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m3" value="4. Show login page" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;exitX=0;exitY=1.0;entryX=0.5;entryY=0.2784;strokeColor=#173330;fontColor=#173330;fontSize=11;fontFamily=Arial;labelBackgroundColor=#FFFFFF;endSize=8;" edge="1" parent="1" source="act0" target="user">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m4" value="5. Email and password" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.3318;entryX=0;entryY=0.0;strokeColor=#173330;fontColor=#173330;fontSize=11;fontFamily=Arial;labelBackgroundColor=#FFFFFF;endSize=8;" edge="1" parent="1" source="user" target="act1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m5" value="6. Check credentials,&lt;br&gt;load realm roles" style="html=1;verticalAlign=middle;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.2727;entryX=1;entryY=0.4432;strokeColor=#173330;fontColor=#173330;fontSize=11;fontFamily=Arial;labelBackgroundColor=#FFFFFF;endSize=8;" edge="1" parent="1" source="act1" target="act1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="560" y="386" /><mxPoint x="560" y="416" /></Array>
          <mxPoint x="73" y="0" as="offset" /></mxGeometry>
        </mxCell>
        <mxCell id="m6" value="7. Start SSO session,&lt;br&gt;issue authorization code" style="html=1;verticalAlign=middle;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.6364;entryX=1;entryY=0.8068;strokeColor=#173330;fontColor=#173330;fontSize=11;fontFamily=Arial;labelBackgroundColor=#FFFFFF;endSize=8;" edge="1" parent="1" source="act1" target="act1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="560" y="450" /><mxPoint x="560" y="480" /></Array>
          <mxPoint x="82" y="0" as="offset" /></mxGeometry>
        </mxCell>
        <mxCell id="m7" value="8. Redirect with code and state" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;exitX=0;exitY=1.0;entryX=1;entryY=0.5333;strokeColor=#173330;fontColor=#173330;fontSize=11;fontFamily=Arial;labelBackgroundColor=#FFFFFF;endSize=8;" edge="1" parent="1" source="act1" target="act3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m8" value="9. Check state" style="html=1;verticalAlign=middle;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.6;entryX=1;entryY=0.6417;strokeColor=#173330;fontColor=#173330;fontSize=11;fontFamily=Arial;labelBackgroundColor=#FFFFFF;endSize=8;" edge="1" parent="1" source="act3" target="act3">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="360" y="562" /><mxPoint x="360" y="592" /></Array>
          <mxPoint x="51" y="0" as="offset" /></mxGeometry>
        </mxCell>
        <mxCell id="m9" value="10. POST /token with&lt;br&gt;code, code_verifier" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.6889;entryX=0;entryY=0.0;strokeColor=#173330;fontColor=#173330;fontSize=11;fontFamily=Arial;labelBackgroundColor=#FFFFFF;endSize=8;" edge="1" parent="1" source="act3" target="act2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m10" value="11. Check code&lt;br&gt;and PKCE" style="html=1;verticalAlign=middle;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.4286;entryX=1;entryY=0.6964;strokeColor=#173330;fontColor=#173330;fontSize=11;fontFamily=Arial;labelBackgroundColor=#FFFFFF;endSize=8;" edge="1" parent="1" source="act2" target="act2">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="560" y="674" /><mxPoint x="560" y="704" /></Array>
          <mxPoint x="51" y="0" as="offset" /></mxGeometry>
        </mxCell>
        <mxCell id="m11" value="12. Access, refresh and ID token" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;exitX=0;exitY=1.0;entryX=1;entryY=0.8444;strokeColor=#173330;fontColor=#173330;fontSize=11;fontFamily=Arial;labelBackgroundColor=#FFFFFF;endSize=8;" edge="1" parent="1" source="act2" target="act3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m12" value="13. Store tokens" style="html=1;verticalAlign=middle;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.9111;entryX=1;entryY=0.9528;strokeColor=#173330;fontColor=#173330;fontSize=11;fontFamily=Arial;labelBackgroundColor=#FFFFFF;endSize=8;" edge="1" parent="1" source="act3" target="act3">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="360" y="786" /><mxPoint x="360" y="816" /></Array>
          <mxPoint x="58" y="0" as="offset" /></mxGeometry>
        </mxCell>
        <mxCell id="m13" value="14. Signed in" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;exitX=0;exitY=1.0;entryX=0.5;entryY=0.902;strokeColor=#173330;fontColor=#173330;fontSize=11;fontFamily=Arial;labelBackgroundColor=#FFFFFF;endSize=8;" edge="1" parent="1" source="act3" target="user">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      <mxCell id="legend" value="Legend" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#173330;align=left;verticalAlign=top;container=1;collapsible=0;fontSize=11;fontStyle=1;fontColor=#173330;fontFamily=Arial;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="20" y="954.0" width="600" height="62" as="geometry" /></mxCell>
<mxCell id="legend_call" value="" style="html=1;endArrow=block;endSize=8;strokeColor=#173330;" edge="1" parent="legend"><mxGeometry relative="1" as="geometry"><mxPoint x="10" y="40" as="sourcePoint" /><mxPoint x="50" y="40" as="targetPoint" /></mxGeometry></mxCell>
<mxCell id="legend_call_t" value="Call (synchronous)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#173330;fontFamily=Arial;" vertex="1" parent="legend"><mxGeometry x="56" y="28" width="110" height="24" as="geometry" /></mxCell>
<mxCell id="legend_ret" value="" style="html=1;endArrow=open;dashed=1;endSize=8;strokeColor=#173330;" edge="1" parent="legend"><mxGeometry relative="1" as="geometry"><mxPoint x="176" y="40" as="sourcePoint" /><mxPoint x="216" y="40" as="targetPoint" /></mxGeometry></mxCell>
<mxCell id="legend_ret_t" value="Reply or redirect" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#173330;fontFamily=Arial;" vertex="1" parent="legend"><mxGeometry x="222" y="28" width="100" height="24" as="geometry" /></mxCell>
<mxCell id="legend_bar" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;fillColor=#FFFFFF;strokeColor=#173330;" vertex="1" parent="legend"><mxGeometry x="336" y="26" width="10" height="28" as="geometry" /></mxCell>
<mxCell id="legend_bar_t" value="Activation (lifeline is busy)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#173330;fontFamily=Arial;" vertex="1" parent="legend"><mxGeometry x="352" y="28" width="160" height="24" as="geometry" /></mxCell>
</root>
    </mxGraphModel>
  </diagram>
