        <mxCell id="legend_sym4" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#173330;fontColor=#173330;fontSize=12;fontFamily=Arial;spacing=0;" vertex="1" parent="legend"><mxGeometry x="216" y="29" width="30" height="22" as="geometry"/></mxCell>
        <mxCell id="legend_txt4" value="Decision with [guards]" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#173330;fontFamily=Arial;" vertex="1" parent="legend"><mxGeometry x="250" y="24" width="135" height="32" as="geometry"/></mxCell>
        <mxCell id="legend_sym5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=open;endSize=10;strokeColor=#173330;fontColor=#173330;fontSize=11;fontFamily=Arial;labelBackgroundColor=#FFFFFF;" edge="1" parent="legend"><mxGeometry relative="1" as="geometry"><mxPoint x="393" y="40" as="sourcePoint"/><mxPoint x="427" y="40" as="targetPoint"/></mxGeometry></mxCell>
