        </mxCell>
        <mxCell id="n_receive" value="Receive email and&lt;br&gt;temporary password" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0284C7;fontFamily=Arial;fontSize=11;" vertex="1" parent="lane_admin2">
          <mxGeometry x="35" y="365" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n_open" value="Open the admin panel and click 'Sign in'" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0284C7;fontFamily=Arial;fontSize=11;" vertex="1" parent="lane_admin2">
          <mxGeometry x="35" y="450" width="240" height="40" as="geometry" />
        </mxCell>
        <mxCell id="n_login" value="Enter email and&lt;br&gt;temporary password" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0284C7;fontFamily=Arial;fontSize=11;" vertex="1" parent="lane_admin2">
          <mxGeometry x="35" y="610" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n_newpwd" value="Choose a new personal password" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0284C7;fontFamily=Arial;fontSize=11;" vertex="1" parent="lane_admin2">
          <mxGeometry x="35" y="770" width="240" height="45" as="geometry" />
        </mxCell>
        <mxCell id="w_redirect" value="AuthGate: signinRedirect()&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B;&quot;&gt;(client prepmeup-admin, PKCE)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;fontFamily=Arial;fontSize=11;" vertex="1" parent="lane_web">
          <mxGeometry x="35" y="445" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="w_callback" value="Receive code and exchange for tokens&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#15803D;&quot;&gt;(POST /token with code and code_verifier)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#15803D;fontFamily=Arial;fontSize=11;" vertex="1" parent="lane_web">
          <mxGeometry x="35" y="845" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="w_store" value="Tokens are kept in memory only" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontFamily=Arial;fontSize=11;" vertex="1" parent="lane_web">
