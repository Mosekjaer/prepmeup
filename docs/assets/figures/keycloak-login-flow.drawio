          <mxGeometry x="50" y="215" width="980" height="225" as="geometry" />
        </mxCell>
        <mxCell id="phase_0_lbl" value="&lt;b&gt;FASE 1: Initialisering &amp; OIDC Authorization Request (PKCE)&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=10;fontColor=#B3D7FF;fontSize=11;fontFamily=Arial;" vertex="1" parent="phase_0">
