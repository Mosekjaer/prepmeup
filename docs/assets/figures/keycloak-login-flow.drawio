          <mxGeometry x="50" y="455" width="980" height="260" as="geometry" />
        </mxCell>
        <mxCell id="phase_1_lbl" value="&lt;b&gt;FASE 2: Brugerautentificering hos Keycloak (Direkte browser-interaktion)&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=10;fontColor=#D8B4FE;fontSize=11;fontFamily=Arial;" vertex="1" parent="phase_1">
          <mxGeometry x="5" y="0" width="600" height="26" as="geometry" />
