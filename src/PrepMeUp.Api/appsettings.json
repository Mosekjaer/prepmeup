{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "ConnectionStrings": {
    "PrepMeUpDb": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Keycloak": {
    "Authority": "",
    "MetadataAddress": "",
    "Audience": "prepmeup-api",
    "RequireHttpsMetadata": true
  },
  "AllowedHosts": "*"
}
