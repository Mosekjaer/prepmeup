# ============================================================
#  Build artifacts stay local.
# ============================================================

# All compile output lives here (see latexmkrc)
build/

# Local-only latexmk config (has machine-specific paths;
# teammates: copy latexmkrc.example -> latexmkrc)
/latexmkrc

# Local reference copy of the AU report template
rapport-eksempel-main/

# LaTeX auxiliary files (if compiled without latexmkrc)
*.aux
*.log
*.out
*.toc
*.lof
*.lot
*.loc
*.fls
*.fdb_latexmk
*.synctex
*.synctex.gz
*.synctex(busy)
*.synctex.gz(busy)
*.bbl
*.bcf
*.blg
*.run.xml
*.nav
*.snm
*.vrb
_minted*

# Compiled PDFs are build output, EXCEPT assets/figures/*.pdf:
# latexmk has no rule to rebuild those (plain standalone TikZ),
# so they're committed by hand. assets/drawio/*.pdf IS rebuilt
# automatically by the drawio rule in latexmkrc, so it stays ignored.
*.pdf
!assets/figures/*.pdf

# DrawIO temp files
*.drawio.bkp
*.drawio.dtmp

# OS
.DS_Store
Thumbs.db
