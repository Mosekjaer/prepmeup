        <mxCell id="fc_e10_no" edge="1" parent="1" source="node_client_dec_state" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#DC2626;strokeWidth=1.5;fontFamily=Arial;fontSize=10;fontColor=#DC2626;fontStyle=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" target="node_client_err_csrf" value="No">
          <mxGeometry relative="1" as="geometry">
