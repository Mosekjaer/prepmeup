{
  "info": {
    "name": "PrepMeUp NFR-09 to NFR-11 access control",
    "description": "Acceptance tests for NFR-09, NFR-10 and NFR-11 (appendix 6.1). Set customerNameA and customerNameB to the names of customer A and B, and expiredToken to a token that is more than 15 minutes old (copy it from Postman and wait). Get a new token as the user each folder names. NFR-09 also needs the API's OpenAPI document checked by hand. See README.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "oauth2",
    "oauth2": [
      {
        "key": "grant_type",
        "value": "authorization_code_with_pkce",
        "type": "string"
      },
      {
        "key": "authUrl",
        "value": "{{keycloakUrl}}/realms/prepmeup/protocol/openid-connect/auth",
        "type": "string"
      },
      {
        "key": "accessTokenUrl",
        "value": "{{keycloakUrl}}/realms/prepmeup/protocol/openid-connect/token",
        "type": "string"
      },
      {
        "key": "clientId",
        "value": "prepmeup-admin",
        "type": "string"
      },
      {
        "key": "scope",
        "value": "openid",
        "type": "string"
      },
      {
        "key": "redirect_uri",
        "value": "http://localhost:5173/",
        "type": "string"
      },
      {
        "key": "challengeAlgorithm",
        "value": "S256",
        "type": "string"
      },
      {
        "key": "client_authentication",
        "value": "body",
        "type": "string"
      },
      {
        "key": "addTokenTo",
        "value": "header",
        "type": "string"
      },
      {
        "key": "tokenName",
        "value": "PrepMeUp local",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5001"
    },
    {
      "key": "keycloakUrl",
      "value": "http://localhost:8082"
    },
    {
      "key": "customerNameA",
      "value": ""
    },
    {
      "key": "customerNameB",
      "value": ""
    },
    {
      "key": "expiredToken",
      "value": ""
    },
    {
      "key": "unknownOrder",
      "value": "f05f0000-0000-0000-0000-000000000000"
    }
  ],
  "item": [
    {
      "name": "1 NFR-11: no valid token",
      "item": [
        {
          "name": "1a No Authorization header",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Without a header the API answers 401', function () { pm.response.to.have.status(401); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/customer",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "customer"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "1b A token that is not a JWT",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('A token that is not a JWT gives 401', function () { pm.response.to.have.status(401); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer not-a-jwt"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/customer",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "customer"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "1c An expired token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('The variable expiredToken holds a token that is more than 15 minutes old', function () { pm.expect(pm.collectionVariables.get('expiredToken'), 'Set expiredToken first').to.be.a('string').and.not.empty; });",
                  "pm.test('An expired token gives 401', function () { pm.response.to.have.status(401); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{expiredToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/customer",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "customer"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "2 NFR-10: administrator endpoints as a customer",
      "item": [
        {
          "name": "2a GET /admin/ping",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('A customer token gives 403', function () { pm.response.to.have.status(403); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/ping",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "ping"
              ]
            }
          }
        },
        {
          "name": "2b GET /admin/orders/planned",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('A customer token gives 403', function () { pm.response.to.have.status(403); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/orders/planned",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "orders",
                "planned"
              ]
            }
          }
        },
        {
          "name": "2c POST /admin/orders/{orderId}/shipment",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('A customer token gives 403', function () { pm.response.to.have.status(403); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/orders/{{unknownOrder}}/shipment",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "orders",
                "{{unknownOrder}}",
                "shipment"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "3 NFR-10: administrator endpoints as the administrator",
      "item": [
        {
          "name": "3a GET /admin/ping",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('The administrator gets 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/ping",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "ping"
              ]
            }
          }
        },
        {
          "name": "3b GET /admin/orders/planned",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('The administrator gets 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/orders/planned",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "orders",
                "planned"
              ]
            }
          }
        },
        {
          "name": "3c POST /admin/orders/{orderId}/shipment (unknown order)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('The administrator passes the authorization and gets 404 for an unknown order', function () { pm.response.to.have.status(404); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/orders/{{unknownOrder}}/shipment",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "orders",
                "{{unknownOrder}}",
                "shipment"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "4 NFR-09: customer A",
      "item": [
        {
          "name": "4a GET /customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('The user is customer A', function () { pm.expect(pm.response.json().name).to.equal(pm.collectionVariables.get('customerNameA')); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/customer",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "customer"
              ]
            }
          }
        },
        {
          "name": "4b GET /subscription",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('The subscription has an order', function () { pm.expect(pm.response.json().orders).to.be.an('array').that.is.not.empty; });",
                  "pm.collectionVariables.set('ordersA', JSON.stringify(pm.response.json().orders));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/subscription",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "subscription"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "5 NFR-09: customer B",
      "item": [
        {
          "name": "5a GET /customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('The user is customer B', function () { pm.expect(pm.response.json().name).to.equal(pm.collectionVariables.get('customerNameB')); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/customer",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "customer"
              ]
            }
          }
        },
        {
          "name": "5b GET /subscription",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('The orders are not the orders of customer A', function () { pm.expect(JSON.stringify(pm.response.json().orders)).to.not.equal(pm.collectionVariables.get('ordersA')); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/subscription",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "subscription"
              ]
            }
          }
        }
      ]
    }
  ]
}
