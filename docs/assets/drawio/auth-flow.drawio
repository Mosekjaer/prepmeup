<mxfile host="drawio">
  <diagram name="Login flow" id="auth-flow">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="760" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="user" value="User (customer or administrator)" style="shape=umlActor;verticalLabelPosition=middle;labelPosition=left;align=right;verticalAlign=middle;spacingRight=8;html=1;fontSize=12;fontStyle=1;strokeColor=#173330;fontColor=#173330;fillColor=#FFFFFF;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="600" y="0" width="30" height="54" as="geometry"/></mxCell>
        <mxCell id="client" value="&lt;b&gt;Client&lt;/b&gt;&lt;br&gt;Customer app (Expo)&lt;br&gt;or Admin panel&lt;br&gt;(React, Vite)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=10;fontSize=12;fillColor=#FFFFFF;strokeColor=#173330;fontColor=#173330;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="0" y="100" width="170" height="560" as="geometry"/></mxCell>
        <mxCell id="keycloak" value="&lt;b&gt;Keycloak&lt;/b&gt;&lt;br&gt;realm prepmeup" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=10;fontSize=12;fillColor=#FFFFFF;strokeColor=#173330;fontColor=#173330;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="530" y="100" width="170" height="290" as="geometry"/></mxCell>
        <mxCell id="api" value="&lt;b&gt;Web API&lt;/b&gt;&lt;br&gt;ASP.NET Core, .NET 10" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=10;fontSize=12;fillColor=#FFFFFF;strokeColor=#173330;fontColor=#173330;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="530" y="480" width="170" height="180" as="geometry"/></mxCell>
        <mxCell id="e1" value="&lt;b&gt;1&lt;/b&gt;  Open the login page in the system browser&lt;br&gt;GET …/openid-connect/auth&lt;br&gt;client_id, redirect_uri, state, code_challenge (S256)" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#173330;fontColor=#173330;fontFamily=Arial;exitX=1;exitY=0.054;exitDx=0;exitDy=0;entryX=0;entryY=0.103;entryDx=0;entryDy=0;" edge="1" source="client" target="keycloak" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e2" value="&lt;b&gt;2&lt;/b&gt;  email + password&lt;br&gt;typed into Keycloak's page" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#173330;fontColor=#173330;fontFamily=Arial;labelPosition=left;align=right;spacingRight=6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="user" target="keycloak" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e3" value="&lt;b&gt;3&lt;/b&gt;  Redirect back with a one-time code&lt;br&gt;302 redirect_uri?code=…&amp;amp;state=…" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#173330;fontColor=#173330;fontFamily=Arial;exitX=0;exitY=0.414;exitDx=0;exitDy=0;entryX=1;entryY=0.214;entryDx=0;entryDy=0;" edge="1" source="keycloak" target="client" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e4" value="&lt;b&gt;4&lt;/b&gt;  Swap the code for tokens&lt;br&gt;POST …/openid-connect/token&lt;br&gt;code, code_verifier" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#173330;fontColor=#173330;fontFamily=Arial;exitX=1;exitY=0.339;exitDx=0;exitDy=0;entryX=0;entryY=0.655;entryDx=0;entryDy=0;" edge="1" source="client" target="keycloak" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e5" value="&lt;b&gt;5&lt;/b&gt;  200 access token (JWT, 15 min)&lt;br&gt;and refresh token" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#173330;fontColor=#173330;fontFamily=Arial;exitX=0;exitY=0.897;exitDx=0;exitDy=0;entryX=1;entryY=0.464;entryDx=0;entryDy=0;" edge="1" source="keycloak" target="client" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e6" value="&lt;b&gt;6&lt;/b&gt;  Call the API with the token&lt;br&gt;GET /user&lt;br&gt;Authorization: Bearer &amp;lt;access token&amp;gt;" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#173330;fontColor=#173330;fontFamily=Arial;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.222;entryDx=0;entryDy=0;" edge="1" source="client" target="api" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e7" value="&lt;b&gt;7&lt;/b&gt;  GET …/certs: Keycloak's public keys&lt;br&gt;fetched once, then cached" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#173330;fontColor=#173330;fontFamily=Arial;labelPosition=left;align=right;spacingRight=6;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" source="api" target="keycloak" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e8" value="&lt;b&gt;8&lt;/b&gt;  Check signature, issuer, audience, expiry&lt;br&gt;200 data  |  401 bad token  |  403 wrong role" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#173330;fontColor=#173330;fontFamily=Arial;exitX=0;exitY=0.722;exitDx=0;exitDy=0;entryX=1;entryY=0.911;entryDx=0;entryDy=0;" edge="1" source="api" target="client" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="legend" value="Legend" style="rounded=0;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontSize=12;fillColor=#FAFAFA;strokeColor=#999999;fontColor=#173330;fontFamily=Arial;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="0" y="690" width="700" height="66" as="geometry"/></mxCell>
        <mxCell id="lg0" value="" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#173330;fontColor=#173330;fontFamily=Arial;" edge="1" parent="legend"><mxGeometry relative="1" as="geometry"><mxPoint x="10" y="46" as="sourcePoint"/><mxPoint x="60" y="46" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="lt0" value="Request or user input" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#173330;fontFamily=Arial;" vertex="1" parent="legend"><mxGeometry x="68" y="32" width="150" height="28" as="geometry"/></mxCell>
        <mxCell id="lg1" value="" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#173330;fontColor=#173330;fontFamily=Arial;" edge="1" parent="legend"><mxGeometry relative="1" as="geometry"><mxPoint x="230" y="46" as="sourcePoint"/><mxPoint x="280" y="46" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="lt1" value="Response or redirect" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#173330;fontFamily=Arial;" vertex="1" parent="legend"><mxGeometry x="288" y="32" width="150" height="28" as="geometry"/></mxCell>
        <mxCell id="lt2" value="&lt;b&gt;1&lt;/b&gt; … &lt;b&gt;8&lt;/b&gt;: order of the steps" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#173330;fontFamily=Arial;" vertex="1" parent="legend"><mxGeometry x="450" y="32" width="245" height="28" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
