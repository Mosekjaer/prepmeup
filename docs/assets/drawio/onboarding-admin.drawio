<mxCell id="a1_start" value="Start: Eksisterende admin logger ind&#xa;i Keycloak Admin Console" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontFamily=Arial;fontSize=11;fontStyle=1;" vertex="1" parent="lane_admin1">
          <mxGeometry x="45" y="45" width="240" height="50" as="geometry" />
        </mxCell>
<mxCell id="a1_create" value="Opret ny bruger i realm prepmeup:&#xa;• E-mail, Fornavn, Efternavn&#xa;• Sæt 'Required Action: Update Password'" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;fontFamily=Arial;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="lane_admin1">
          <mxGeometry x="45" y="125" width="240" height="55" as="geometry" />
        </mxCell>
<mxCell id="a1_assign_role" value="Tildel Realm-rolle: 'admin'&#xa;&lt;span style=&quot;font-size:10px;color:#7E22CE;&quot;&gt;(Role Mapping: Bruger får 'admin'-claim)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7E22CE;fontFamily=Arial;fontSize=11;" vertex="1" parent="lane_admin1">
