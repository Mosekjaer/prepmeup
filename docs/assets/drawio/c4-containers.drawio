<mxfile host="drawio">
  <diagram name="C4 Containers" id="c4ctr">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="ctr-boundary" value="&lt;b&gt;PrepMeUp&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Software System]&lt;/span&gt;" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;fillColor=none;strokeColor=#666666;fontColor=#333333;dashed=1;dashPattern=8 4;align=left;verticalAlign=bottom;spacingLeft=12;spacingBottom=8;fontSize=13;container=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="280" width="1160" height="600" as="geometry"/>
        </mxCell>
        <mxCell id="ctr-customer" value="&lt;b&gt;Customer&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Person]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;A household that subscribes to emergency preparedness packages&lt;/span&gt;" style="shape=mxgraph.c4.person2;html=1;whiteSpace=wrap;fontSize=13;fontColor=#ffffff;align=center;verticalAlign=bottom;spacingBottom=10;fillColor=#083F75;strokeColor=#06315C;" vertex="1" parent="1">
          <mxGeometry x="110" y="30" width="200" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="ctr-admin" value="&lt;b&gt;Administrator&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Person]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;PrepMeUp employee who maintains package types and sends orders&lt;/span&gt;" style="shape=mxgraph.c4.person2;html=1;whiteSpace=wrap;fontSize=13;fontColor=#ffffff;align=center;verticalAlign=bottom;spacingBottom=10;fillColor=#083F75;strokeColor=#06315C;" vertex="1" parent="1">
          <mxGeometry x="930" y="30" width="200" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="ctr-keycloak" value="&lt;b&gt;Keycloak&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Software System: identity provider]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Stores accounts and passwords. Shows the login page and issues access tokens&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=13;fontColor=#ffffff;align=center;fillColor=#8C8496;strokeColor=#736782;" vertex="1" parent="1">
          <mxGeometry x="480" y="50" width="280" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="ctr-mobile" value="&lt;b&gt;Customer app&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Container: Expo, React Native, TypeScript]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Lets the customer manage the household, the subscription and the orders. Runs on Android&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=13;fontColor=#ffffff;align=center;fillColor=#23A2D9;strokeColor=#0E7DAD;" vertex="1" parent="1">
          <mxGeometry x="80" y="340" width="260" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="ctr-adminpanel" value="&lt;b&gt;Admin panel&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Container: React, Vite, TypeScript]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Single-page app in the browser for package types and sending orders. Served by nginx&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=13;fontColor=#ffffff;align=center;fillColor=#23A2D9;strokeColor=#0E7DAD;" vertex="1" parent="1">
          <mxGeometry x="900" y="340" width="260" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="ctr-api" value="&lt;b&gt;Web API&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Container: ASP.NET Core, .NET 10]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Holds the business rules and exposes them as a REST API, described by an OpenAPI document&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=13;fontColor=#ffffff;align=center;fillColor=#23A2D9;strokeColor=#0E7DAD;" vertex="1" parent="1">
          <mxGeometry x="480" y="520" width="280" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="ctr-db" value="&lt;b&gt;Database&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Container: SQL Server]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Customers, subscriptions, orders and package types&lt;/span&gt;" style="shape=cylinder3;size=15;boundedLbl=1;html=1;whiteSpace=wrap;fontSize=13;fontColor=#ffffff;align=center;fillColor=#23A2D9;strokeColor=#0E7DAD;" vertex="1" parent="1">
          <mxGeometry x="490" y="730" width="260" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="ctr-e1" value="Logs in with&lt;br&gt;e-mail and password" style="endArrow=blockThin;endFill=1;endSize=10;html=1;fontSize=11;fontColor=#404040;strokeColor=#828282;labelBackgroundColor=#ffffff;rounded=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ctr-customer" target="ctr-keycloak">
