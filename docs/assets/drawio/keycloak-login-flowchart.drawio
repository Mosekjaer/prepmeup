<mxfile host="drawio">
  <diagram id="keycloak-login-flowchart" name="Keycloak login">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="700" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="lane_client" value="Customer app or Admin panel" style="swimlane;html=1;startSize=30;horizontal=1;whiteSpace=wrap;collapsible=0;fillColor=#E8F0EE;swimlaneFillColor=#FFFFFF;strokeColor=#173330;fontColor=#173330;fontStyle=1;fontSize=13;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="340" height="912" as="geometry"/></mxCell>
        <mxCell id="lane_kc" value="Keycloak" style="swimlane;html=1;startSize=30;horizontal=1;whiteSpace=wrap;collapsible=0;fillColor=#E8F0EE;swimlaneFillColor=#FFFFFF;strokeColor=#173330;fontColor=#173330;fontStyle=1;fontSize=13;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="340" y="0" width="360" height="912" as="geometry"/></mxCell>
        <mxCell id="node_start" value="" style="ellipse;html=1;aspect=fixed;fillColor=#173330;strokeColor=#173330;" vertex="1" parent="lane_client"><mxGeometry x="113" y="42" width="24" height="24" as="geometry"/></mxCell>
        <mxCell id="node_click" value="1. Click Sign in" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#173330;fontColor=#173330;fontSize=12;fontFamily=Arial;spacingLeft=4;spacingRight=4;" vertex="1" parent="lane_client"><mxGeometry x="15" y="84" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="node_pkce_gen" value="2. Generate code_verifier, code_challenge and state" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#173330;fontColor=#173330;fontSize=12;fontFamily=Arial;spacingLeft=4;spacingRight=4;" vertex="1" parent="lane_client"><mxGeometry x="15" y="140" width="220" height="44" as="geometry"/></mxCell>
        <mxCell id="node_open_browser" value="3. Open login URL with client_id, redirect_uri, code_challenge and state" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#173330;fontColor=#173330;fontSize=12;fontFamily=Arial;spacingLeft=4;spacingRight=4;" vertex="1" parent="lane_client"><mxGeometry x="15" y="204" width="220" height="56" as="geometry"/></mxCell>
        <mxCell id="node_kc_display" value="4. Show login page" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#173330;fontColor=#173330;fontSize=12;fontFamily=Arial;spacingLeft=4;spacingRight=4;" vertex="1" parent="lane_kc"><mxGeometry x="15" y="212" width="220" height="40" as="geometry"/></mxCell>
        <mxCell id="node_kc_submit" value="5. User enters email and password" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#173330;fontColor=#173330;fontSize=12;fontFamily=Arial;spacingLeft=4;spacingRight=4;" vertex="1" parent="lane_kc"><mxGeometry x="15" y="272" width="220" height="40" as="geometry"/></mxCell>
        <mxCell id="node_kc_dec_creds" value="6. Credentials&lt;br&gt;correct?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#173330;fontColor=#173330;fontSize=12;fontFamily=Arial;spacing=0;" vertex="1" parent="lane_kc"><mxGeometry x="45" y="332" width="160" height="64" as="geometry"/></mxCell>
        <mxCell id="node_kc_err_creds" value="Show error" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#173330;fontColor=#173330;fontSize=12;fontFamily=Arial;spacingLeft=4;spacingRight=4;" vertex="1" parent="lane_kc"><mxGeometry x="252" y="292" width="96" height="40" as="geometry"/></mxCell>
        <mxCell id="node_kc_gen_code" value="7. Start SSO session, issue authorization code" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#173330;fontColor=#173330;fontSize=12;fontFamily=Arial;spacingLeft=4;spacingRight=4;" vertex="1" parent="lane_kc"><mxGeometry x="15" y="420" width="220" height="44" as="geometry"/></mxCell>
        <mxCell id="node_kc_redirect" value="8. Redirect to redirect_uri with code and state" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#173330;fontColor=#173330;fontSize=12;fontFamily=Arial;spacingLeft=4;spacingRight=4;" vertex="1" parent="lane_kc"><mxGeometry x="15" y="488" width="220" height="44" as="geometry"/></mxCell>
        <mxCell id="node_client_callback" value="8. Receive code and state" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#173330;fontColor=#173330;fontSize=12;fontFamily=Arial;spacingLeft=4;spacingRight=4;" vertex="1" parent="lane_client"><mxGeometry x="15" y="490" width="220" height="40" as="geometry"/></mxCell>
        <mxCell id="node_client_dec_state" value="9. State matches?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#173330;fontColor=#173330;fontSize=12;fontFamily=Arial;spacing=0;" vertex="1" parent="lane_client"><mxGeometry x="50" y="556" width="150" height="64" as="geometry"/></mxCell>
        <mxCell id="node_client_err_csrf" value="Stop login" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F6E3E1;strokeColor=#8A2F25;fontColor=#8A2F25;fontSize=12;fontFamily=Arial;spacingLeft=2;spacingRight=2;" vertex="1" parent="lane_client"><mxGeometry x="240" y="568" width="92" height="40" as="geometry"/></mxCell>
        <mxCell id="node_client_end_csrf" value="" style="ellipse;html=1;shape=endState;aspect=fixed;fillColor=#173330;strokeColor=#173330;" vertex="1" parent="lane_client"><mxGeometry x="273" y="626" width="26" height="26" as="geometry"/></mxCell>
        <mxCell id="node_client_post_token" value="10. Send code and code_verifier to token endpoint" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#173330;fontColor=#173330;fontSize=12;fontFamily=Arial;spacingLeft=4;spacingRight=4;" vertex="1" parent="lane_client"><mxGeometry x="15" y="652" width="220" height="44" as="geometry"/></mxCell>
        <mxCell id="node_kc_dec_pkce" value="11. Code and&lt;br&gt;PKCE valid?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#173330;fontColor=#173330;fontSize=12;fontFamily=Arial;spacing=0;" vertex="1" parent="lane_kc"><mxGeometry x="45" y="642" width="160" height="64" as="geometry"/></mxCell>
        <mxCell id="node_kc_err_pkce" value="Answer 400 invalid_grant" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F6E3E1;strokeColor=#8A2F25;fontColor=#8A2F25;fontSize=12;fontFamily=Arial;spacingLeft=2;spacingRight=2;" vertex="1" parent="lane_kc"><mxGeometry x="252" y="652" width="96" height="44" as="geometry"/></mxCell>
        <mxCell id="node_kc_end_pkce" value="" style="ellipse;html=1;shape=endState;aspect=fixed;fillColor=#173330;strokeColor=#173330;" vertex="1" parent="lane_kc"><mxGeometry x="287" y="718" width="26" height="26" as="geometry"/></mxCell>
        <mxCell id="node_kc_issue_tokens" value="12. Issue access token, refresh token and ID token" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#173330;fontColor=#173330;fontSize=12;fontFamily=Arial;spacingLeft=4;spacingRight=4;" vertex="1" parent="lane_kc"><mxGeometry x="15" y="740" width="220" height="44" as="geometry"/></mxCell>
        <mxCell id="node_client_save_token" value="13. Store tokens, give access token to API client" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#173330;fontColor=#173330;fontSize=12;fontFamily=Arial;spacingLeft=4;spacingRight=4;" vertex="1" parent="lane_client"><mxGeometry x="15" y="740" width="220" height="44" as="geometry"/></mxCell>
        <mxCell id="node_client_finish" value="14. User is signed in" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#173330;fontColor=#173330;fontSize=12;fontFamily=Arial;spacingLeft=4;spacingRight=4;" vertex="1" parent="lane_client"><mxGeometry x="15" y="810" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="node_end" value="" style="ellipse;html=1;shape=endState;aspect=fixed;fillColor=#173330;strokeColor=#173330;" vertex="1" parent="lane_client"><mxGeometry x="112" y="870" width="26" height="26" as="geometry"/></mxCell>
