<mxfile>
  <diagram id="seqlayout" name="Customer app login">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="u" value="User" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;participant=umlActor;verticalAlign=bottom;spacingBottom=-14;labelBackgroundColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="100" height="1270" as="geometry"/>
        </mxCell>
        <mxCell id="app" value="Customer app" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;" vertex="1" parent="1">
          <mxGeometry x="310" y="40" width="100" height="1270" as="geometry"/>
        </mxCell>
        <mxCell id="br" value="System browser&#xa;(Custom Tab)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;" vertex="1" parent="1">
          <mxGeometry x="580" y="40" width="100" height="1270" as="geometry"/>
        </mxCell>
        <mxCell id="kc" value="Keycloak&#xa;realm prepmeup" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;" vertex="1" parent="1">
          <mxGeometry x="850" y="40" width="100" height="1270" as="geometry"/>
        </mxCell>
        <mxCell id="api" value="PrepMeUp API" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;" vertex="1" parent="1">
          <mxGeometry x="1120" y="40" width="100" height="1270" as="geometry"/>
        </mxCell>
        <mxCell id="act0" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#ffffff;" vertex="1" parent="kc">
          <mxGeometry x="45" y="90" width="10" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="act1" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#ffffff;" vertex="1" parent="kc">
          <mxGeometry x="45" y="360" width="10" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="act2" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#ffffff;" vertex="1" parent="kc">
          <mxGeometry x="45" y="510" width="10" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="act3" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#ffffff;" vertex="1" parent="br">
          <mxGeometry x="45" y="310" width="10" height="300" as="geometry"/>
        </mxCell>
        <mxCell id="act4" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#ffffff;" vertex="1" parent="kc">
          <mxGeometry x="45" y="730" width="10" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="act5" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#ffffff;" vertex="1" parent="kc">
          <mxGeometry x="45" y="950" width="10" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="act6" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#ffffff;" vertex="1" parent="api">
          <mxGeometry x="45" y="900" width="10" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="act7" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#ffffff;" vertex="1" parent="app">
          <mxGeometry x="45" y="190" width="10" height="1040" as="geometry"/>
        </mxCell>
        <mxCell id="m0" value="GET /realms/prepmeup/.well-known/openid-configuration" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.0709;entryX=0;entryY=0.0;" edge="1" parent="1" source="app" target="act0">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m1" value="200 authorization_endpoint, token_endpoint, end_session_endpoint" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=0;exitY=1.0;entryX=0.5;entryY=0.1102;" edge="1" parent="1" source="act0" target="app">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m2" value="tap Sign in" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.1496;entryX=0;entryY=0.0;" edge="1" parent="1" source="u" target="act7">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m3" value="new code_verifier, state;&#xa;code_challenge = BASE64URL(SHA256(code_verifier))" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.0481;entryX=1;entryY=0.0769;" edge="1" parent="1" source="act7" target="act7">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="420" y="280"/><mxPoint x="420" y="310"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="m4" value="open authorization URL" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.1154;entryX=0;entryY=0.0;" edge="1" parent="1" source="act7" target="act3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m5" value="GET …/openid-connect/auth?response_type=code&amp;client_id=prepmeup-mobile&#xa;&amp;redirect_uri=prepmeup://auth/callback&amp;scope=openid&amp;state&amp;code_challenge&amp;code_challenge_method=S256" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.1667;entryX=0;entryY=0.0;" edge="1" parent="1" source="act3" target="act1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m6" value="200 login page" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=0;exitY=1.0;entryX=1;entryY=0.3333;" edge="1" parent="1" source="act1" target="act3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m7" value="email + password" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.3622;entryX=0;entryY=0.5;" edge="1" parent="1" source="u" target="act3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m8" value="POST …/login-actions/authenticate (username, password)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.6667;entryX=0;entryY=0.0;" edge="1" parent="1" source="act3" target="act2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m9" value="302 Location: prepmeup://auth/callback?code&amp;state&amp;session_state&amp;iss" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=0;exitY=1.0;entryX=1;entryY=0.8333;" edge="1" parent="1" source="act2" target="act3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m10" value="prepmeup://auth/callback?code&amp;state" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=0;exitY=1.0;entryX=1;entryY=0.4038;" edge="1" parent="1" source="act3" target="act7">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m11" value="check state" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.4519;entryX=1;entryY=0.4808;" edge="1" parent="1" source="act7" target="act7">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="420" y="700"/><mxPoint x="420" y="730"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="m12" value="POST …/openid-connect/token  grant_type=authorization_code&#xa;&amp;code&amp;redirect_uri&amp;client_id=prepmeup-mobile&amp;code_verifier" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.5192;entryX=0;entryY=0.0;" edge="1" parent="1" source="act7" target="act4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m13" value="SHA256(code_verifier) = code_challenge?" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.4167;entryX=1;entryY=0.6667;" edge="1" parent="1" source="act4" target="act4">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="960" y="820"/><mxPoint x="960" y="850"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="m14" value="200 access_token (JWT, 900 s, aud prepmeup-api), id_token, refresh_token" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=0;exitY=1.0;entryX=1;entryY=0.6346;" edge="1" parent="1" source="act4" target="act7">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m15" value="GET /items&#xa;Authorization: Bearer access_token" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.6827;entryX=0;entryY=0.0;" edge="1" parent="1" source="act7" target="act6">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m16" value="GET …/openid-connect/certs (JWKS, cached)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0;exitY=0.2273;entryX=1;entryY=0.0;" edge="1" parent="1" source="act6" target="act5">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m17" value="200 signing keys" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=1;exitY=1.0;entryX=0;entryY=0.4545;" edge="1" parent="1" source="act5" target="act6">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m18" value="check signature, iss, aud, exp;&#xa;realm_access.roles → role claims" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.6818;entryX=1;entryY=0.8182;" edge="1" parent="1" source="act6" target="act6">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="1230" y="1090"/><mxPoint x="1230" y="1120"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="m19" value="200 items | 401 | 403" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=0;exitY=1.0;entryX=1;entryY=0.8942;" edge="1" parent="1" source="act6" target="act7">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="note20" value="Password only goes from browser to Keycloak.&#xa;The app and the API never see it." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="920" y="1190" width="210" height="40" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
