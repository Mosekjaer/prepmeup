<mxCell id="kc_role_set" value="Knyt 'admin' rolle til bruger&#xa;&lt;span style=&quot;font-size:10px;color:#15803D;&quot;&gt;(Indlejres i JWT realm_access.roles)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontFamily=Arial;fontSize=11;" vertex="1" parent="lane_kc">
