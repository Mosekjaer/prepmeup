<?xml version='1.0' encoding='UTF-8'?>
<mxfile host="Electron" agent="draw.io" version="26.0.0">
  <diagram id="onboarding-admin" name="Onboarding: Administrator">
    <mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1460" pageHeight="1460" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;font color=&quot;#ffffff&quot;&gt;&lt;b style=&quot;font-size: 20px;&quot;&gt;Onboarding Flowchart — Administrator&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 13px; color: #94A3B8;&quot;&gt;An existing admin creates the user in the Keycloak Admin Console, temporary password, first login with a new password and access check (GET /admin/ping)&lt;/span&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#020617;arcSize=6;align=left;spacingLeft=25;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1380" height="70" as="geometry" />
        </mxCell>
        <mxCell id="lane_kcadmin" value="Existing administrator" style="swimlane;startSize=32;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;fontFamily=Arial;fontSize=12;fontStyle=1;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="40" y="125" width="310" height="1300" as="geometry" />
        </mxCell>
        <mxCell id="lane_admin2" value="New administrator" style="swimlane;startSize=32;fillColor=#F0F9FF;strokeColor=#BAE6FD;strokeWidth=1.5;fontFamily=Arial;fontSize=12;fontStyle=1;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="370" y="125" width="310" height="1300" as="geometry" />
        </mxCell>
        <mxCell id="lane_kc" value="Keycloak (realm: prepmeup)" style="swimlane;startSize=32;fillColor=#FAF5FF;strokeColor=#E9D5FF;strokeWidth=1.5;fontFamily=Arial;fontSize=12;fontStyle=1;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="700" y="125" width="310" height="1300" as="geometry" />
        </mxCell>
        <mxCell id="lane_web" value="Admin panel and API" style="swimlane;startSize=32;fillColor=#F0FDF4;strokeColor=#BBF7D0;strokeWidth=1.5;fontFamily=Arial;fontSize=12;fontStyle=1;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="1030" y="125" width="390" height="1300" as="geometry" />
        </mxCell>
        <mxCell id="k_start" value="Start: logs in to the Keycloak Admin Console&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B;&quot;&gt;(account that can manage users)&lt;/span&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontFamily=Arial;fontSize=11;fontStyle=1;" vertex="1" parent="lane_kcadmin">
          <mxGeometry x="35" y="45" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="k_create" value="Create user in realm prepmeup:&lt;br&gt;email, first name, last name" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;fontFamily=Arial;fontSize=11;" vertex="1" parent="lane_kcadmin">
          <mxGeometry x="35" y="125" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="k_pwd" value="Set a temporary password&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B;&quot;&gt;(Credentials: Temporary = On)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;fontFamily=Arial;fontSize=11;" vertex="1" parent="lane_kcadmin">
          <mxGeometry x="35" y="205" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="k_role" value="Assign the realm role 'admin'&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B;&quot;&gt;(Role mapping)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;fontFamily=Arial;fontSize=11;" vertex="1" parent="lane_kcadmin">
          <mxGeometry x="35" y="285" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="k_handover" value="Give email and temporary password&lt;br&gt;to the new admin &lt;span style=&quot;font-size:10px;color:#64748B;&quot;&gt;(outside the system)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;fontFamily=Arial;fontSize=11;" vertex="1" parent="lane_kcadmin">
          <mxGeometry x="35" y="365" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c_create" value="Create user&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B;&quot;&gt;(gets 'household' automatically as default role)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7E22CE;fontFamily=Arial;fontSize=11;" vertex="1" parent="lane_kc">
          <mxGeometry x="35" y="125" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c_pwd" value="Save password and set&lt;br&gt;required action: Update Password" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7E22CE;fontFamily=Arial;fontSize=11;" vertex="1" parent="lane_kc">
          <mxGeometry x="35" y="205" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c_role" value="Add 'admin' to the user&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748B;&quot;&gt;(put in the token as realm_access.roles)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7E22CE;fontFamily=Arial;fontSize=11;" vertex="1" parent="lane_kc">
          <mxGeometry x="35" y="285" width="240" height="50" as="geometry" />
