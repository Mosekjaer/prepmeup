<mxfile host="drawio">
  <diagram name="C4 System Context" id="c4ctx">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="ctx-customer" value="&lt;b&gt;Customer&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Person]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;A household that subscribes to emergency preparedness packages&lt;/span&gt;" style="shape=mxgraph.c4.person2;html=1;whiteSpace=wrap;fontSize=13;fontColor=#ffffff;align=center;verticalAlign=bottom;spacingBottom=10;fillColor=#083F75;strokeColor=#06315C;" vertex="1" parent="1">
          <mxGeometry x="40" y="50" width="200" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="ctx-admin" value="&lt;b&gt;Administrator&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Person]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;PrepMeUp employee who maintains package types and sends orders&lt;/span&gt;" style="shape=mxgraph.c4.person2;html=1;whiteSpace=wrap;fontSize=13;fontColor=#ffffff;align=center;verticalAlign=bottom;spacingBottom=10;fillColor=#083F75;strokeColor=#06315C;" vertex="1" parent="1">
          <mxGeometry x="880" y="50" width="200" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="ctx-keycloak" value="&lt;b&gt;Keycloak&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Software System: identity provider]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Stores accounts, e-mail addresses and passwords. Shows the login page and issues access tokens&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=13;fontColor=#ffffff;align=center;fillColor=#8C8496;strokeColor=#736782;" vertex="1" parent="1">
          <mxGeometry x="430" y="75" width="260" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="ctx-system" value="&lt;b&gt;PrepMeUp&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Software System]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Recommends a preparedness package for each household, tracks expiry dates and plans the next order&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=14;fontColor=#ffffff;align=center;fillColor=#1061B0;strokeColor=#0D5091;" vertex="1" parent="1">
          <mxGeometry x="410" y="370" width="300" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="ctx-e1" value="Logs in with&lt;br&gt;e-mail and password" style="endArrow=blockThin;endFill=1;endSize=10;html=1;fontSize=11;fontColor=#404040;strokeColor=#828282;labelBackgroundColor=#ffffff;rounded=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ctx-customer" target="ctx-keycloak">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ctx-e2" value="Logs in with&lt;br&gt;an admin account" style="endArrow=blockThin;endFill=1;endSize=10;html=1;fontSize=11;fontColor=#404040;strokeColor=#828282;labelBackgroundColor=#ffffff;rounded=0;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ctx-admin" target="ctx-keycloak">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ctx-e3" value="Manages household,&lt;br&gt;subscription and orders&lt;br&gt;&lt;i&gt;[customer app]&lt;/i&gt;" style="endArrow=blockThin;endFill=1;endSize=10;html=1;fontSize=11;fontColor=#404040;strokeColor=#828282;labelBackgroundColor=#ffffff;rounded=0;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ctx-customer" target="ctx-system">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ctx-e4" value="Maintains package types&lt;br&gt;and sends orders&lt;br&gt;&lt;i&gt;[admin panel]&lt;/i&gt;" style="endArrow=blockThin;endFill=1;endSize=10;html=1;fontSize=11;fontColor=#404040;strokeColor=#828282;labelBackgroundColor=#ffffff;rounded=0;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ctx-admin" target="ctx-system">
