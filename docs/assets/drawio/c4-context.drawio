<mxfile host="drawio">
  <diagram name="C4 System Context" id="c4ctx">
    <mxGraphModel dx="1000" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="ctx-customer" value="&lt;b style=&quot;font-size:14px&quot;&gt;Customer&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;&lt;br&gt;A household that subscribes to emergency preparedness packages" style="shape=mxgraph.c4.person2;html=1;whiteSpace=wrap;fontSize=12;fontFamily=Arial;fontColor=#ffffff;align=center;verticalAlign=bottom;spacingBottom=8;spacingLeft=4;spacingRight=4;fillColor=#083F75;strokeColor=#06315C;" vertex="1" parent="1"><mxGeometry x="30" y="0" width="150" height="215" as="geometry"/></mxCell>
        <mxCell id="ctx-admin" value="&lt;b style=&quot;font-size:14px&quot;&gt;Administrator&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;&lt;br&gt;PrepMeUp employee who maintains package types and sends orders" style="shape=mxgraph.c4.person2;html=1;whiteSpace=wrap;fontSize=12;fontFamily=Arial;fontColor=#ffffff;align=center;verticalAlign=bottom;spacingBottom=8;spacingLeft=4;spacingRight=4;fillColor=#083F75;strokeColor=#06315C;" vertex="1" parent="1"><mxGeometry x="590" y="0" width="150" height="215" as="geometry"/></mxCell>
        <mxCell id="ctx-keycloak" value="&lt;b style=&quot;font-size:14px&quot;&gt;Keycloak&lt;/b&gt;&lt;br&gt;[Software System: identity provider]&lt;br&gt;&lt;br&gt;Stores accounts with email and password, shows the login page and issues access tokens" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontSize=12;fontFamily=Arial;fontColor=#ffffff;align=center;spacing=6;fillColor=#8C8496;strokeColor=#736782;" vertex="1" parent="1"><mxGeometry x="285" y="35" width="200" height="150" as="geometry"/></mxCell>
        <mxCell id="ctx-e1" value="Logs in with&lt;br&gt;email and&lt;br&gt;password" style="endArrow=blockThin;endFill=1;endSize=10;html=1;fontSize=12;fontFamily=Arial;fontColor=#404040;strokeColor=#828282;labelBackgroundColor=#ffffff;rounded=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ctx-customer" target="ctx-keycloak"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="ctx-e2" value="Logs in with&lt;br&gt;an admin&lt;br&gt;account" style="endArrow=blockThin;endFill=1;endSize=10;html=1;fontSize=12;fontFamily=Arial;fontColor=#404040;strokeColor=#828282;labelBackgroundColor=#ffffff;rounded=0;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ctx-admin" target="ctx-keycloak"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="ctx-system" value="&lt;b style=&quot;font-size:14px&quot;&gt;PrepMeUp&lt;/b&gt;&lt;br&gt;[Software System]&lt;br&gt;&lt;br&gt;Recommends a preparedness package for each household, tracks expiry dates and plans the next order" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontSize=12;fontFamily=Arial;fontColor=#ffffff;align=center;spacing=6;fillColor=#1061B0;strokeColor=#0D5091;" vertex="1" parent="1"><mxGeometry x="250" y="330" width="270" height="150" as="geometry"/></mxCell>
        <mxCell id="ctx-e3" value="Manages household,&lt;br&gt;subscription and orders" style="endArrow=blockThin;endFill=1;endSize=10;html=1;fontSize=12;fontFamily=Arial;fontColor=#404040;strokeColor=#828282;labelBackgroundColor=#ffffff;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ctx-customer" target="ctx-system"><mxGeometry relative="1" as="geometry" x="-0.35"><Array as="points"><mxPoint x="105" y="405"/></Array></mxGeometry></mxCell>
