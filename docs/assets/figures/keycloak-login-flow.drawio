<mxCell id="phase_2" value="" style="swimlane;startSize=26;container=1;pointerEvents=0;collapsible=0;rounded=1;arcSize=6;fillColor=#FFFBEB;strokeColor=#FDE68A;strokeWidth=1;dashed=1;opacity=60;fontFamily=Arial;fontSize=11;fontColor=#FDE68A;" vertex="1" parent="1">
          <mxGeometry x="50" y="730" width="980" height="340" as="geometry" />
        </mxCell>
        <mxCell id="phase_2_lbl" value="&lt;b&gt;FASE 3: Authorization Code Grant, PKCE Validering &amp; Token Udstedelse&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=10;fontColor=#FDE68A;fontSize=11;fontFamily=Arial;" vertex="1" parent="phase_2">
          <mxGeometry x="5" y="0" width="600" height="26" as="geometry" />
        </mxCell>
<mxCell id="ll_user" value="Bruger / Slutbruger&#xa;&lt;span style=&quot;font-size:10px;font-weight:normal;color:#555;&quot;&gt;(Kunde eller Admin)&lt;/span&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;participant=umlActor;verticalAlign=bottom;spacingBottom=-12;labelBackgroundColor=#ffffff;fillColor=#ECEFF1;strokeColor=#455A64;strokeWidth=1.5;fontFamily=Arial;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="125" width="140" height="950" as="geometry" />
        </mxCell>
<mxCell id="ll_app" value="PrepMeUp Klient&#xa;&lt;span style=&quot;font-size:10px;font-weight:normal;color:#1565C0;&quot;&gt;(Mobil App / Admin Web)&lt;/span&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=Arial;fontSize=11;fontStyle=1;" vertex="1" parent="1">
