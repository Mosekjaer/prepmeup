# ============================================================
#  Repo-wide ignores. LaTeX-specific rules live in docs/.gitignore.
# ============================================================

# Generated knowledge graph - rebuildable, not part of the project
graphify-out/

# Course material in context/ IS shared with the team, but lecture videos
# are too big for GitHub - get those from Moodle instead.
context/**/*.mp4
context/**/*.mov
context/**/*.mkv
context/**/*.avi

# LaTeX build output (latexmkrc uses build/)
build/
/docs/latexmkrc

# .NET / Visual Studio artifacts
bin/
obj/
.vs/
*.user

# Editors / OS
.idea/
*.swp
.DS_Store
Thumbs.db
