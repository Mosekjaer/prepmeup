          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fc_e6_yes" edge="1" parent="1" source="node_kc_dec_creds" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16A34A;strokeWidth=1.5;fontFamily=Arial;fontSize=10;fontColor=#16A34A;fontStyle=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="node_kc_gen_code" value="Yes">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fc_e6_no" edge="1" parent="1" source="node_kc_dec_creds" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#DC2626;strokeWidth=1.5;fontFamily=Arial;fontSize=10;fontColor=#DC2626;fontStyle=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="node_kc_err_creds" value="No">
          <mxGeometry relative="1" as="geometry">
            <mxPoint y="-10" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="fc_e6_retry" edge="1" parent="1" source="node_kc_err_creds" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#334155;strokeWidth=1.5;fontFamily=Arial;fontSize=10;fontColor=#0F172A;exitX=0.5;exitY=0;entryX=1;entryY=0.5;" target="node_kc_display" value="Try again">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-32" as="offset" />
            <Array as="points">
              <mxPoint x="1085" y="362.5" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="fc_e7" edge="1" parent="1" source="node_kc_gen_code" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#334155;strokeWidth=1.5;fontFamily=Arial;fontSize=10;fontColor=#0F172A;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="node_kc_redirect" value="">
          <mxGeometry relative="1" as="geometry" />
