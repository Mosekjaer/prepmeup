          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fc_e9" edge="1" parent="1" source="node_client_callback" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#334155;strokeWidth=1.5;fontFamily=Arial;fontSize=10;fontColor=#0F172A;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="node_client_dec_state" value="">
