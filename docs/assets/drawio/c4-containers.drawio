<mxfile host="drawio">
  <diagram name="C4 Containers" id="c4ctr">
    <mxGraphModel dx="1000" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="ctr-boundary" value="&lt;b style=&quot;font-size:13px&quot;&gt;PrepMeUp&lt;/b&gt;&lt;br&gt;[Software System]" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;fillColor=none;strokeColor=#666666;fontColor=#333333;dashed=1;dashPattern=8 4;align=left;verticalAlign=bottom;spacingLeft=12;spacingBottom=8;fontSize=12;fontFamily=Arial;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="0" y="285" width="770" height="595" as="geometry"/></mxCell>
        <mxCell id="ctr-customer" value="&lt;b style=&quot;font-size:14px&quot;&gt;Customer&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;&lt;br&gt;A household that subscribes to emergency preparedness packages" style="shape=mxgraph.c4.person2;html=1;whiteSpace=wrap;fontSize=12;fontFamily=Arial;fontColor=#ffffff;align=center;verticalAlign=bottom;spacingBottom=8;spacingLeft=4;spacingRight=4;fillColor=#083F75;strokeColor=#06315C;" vertex="1" parent="1"><mxGeometry x="30" y="0" width="150" height="215" as="geometry"/></mxCell>
        <mxCell id="ctr-admin" value="&lt;b style=&quot;font-size:14px&quot;&gt;Administrator&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;&lt;br&gt;PrepMeUp employee who maintains package types and sends orders" style="shape=mxgraph.c4.person2;html=1;whiteSpace=wrap;fontSize=12;fontFamily=Arial;fontColor=#ffffff;align=center;verticalAlign=bottom;spacingBottom=8;spacingLeft=4;spacingRight=4;fillColor=#083F75;strokeColor=#06315C;" vertex="1" parent="1"><mxGeometry x="590" y="0" width="150" height="215" as="geometry"/></mxCell>
        <mxCell id="ctr-keycloak" value="&lt;b style=&quot;font-size:14px&quot;&gt;Keycloak&lt;/b&gt;&lt;br&gt;[Software System: identity provider]&lt;br&gt;&lt;br&gt;Stores accounts with email and password, shows the login page and issues access tokens" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontSize=12;fontFamily=Arial;fontColor=#ffffff;align=center;spacing=6;fillColor=#8C8496;strokeColor=#736782;" vertex="1" parent="1"><mxGeometry x="285" y="35" width="200" height="150" as="geometry"/></mxCell>
        <mxCell id="ctr-e1" value="Logs in with&lt;br&gt;email and&lt;br&gt;password" style="endArrow=blockThin;endFill=1;endSize=10;html=1;fontSize=12;fontFamily=Arial;fontColor=#404040;strokeColor=#828282;labelBackgroundColor=#ffffff;rounded=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ctr-customer" target="ctr-keycloak"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="ctr-e2" value="Logs in with&lt;br&gt;an admin&lt;br&gt;account" style="endArrow=blockThin;endFill=1;endSize=10;html=1;fontSize=12;fontFamily=Arial;fontColor=#404040;strokeColor=#828282;labelBackgroundColor=#ffffff;rounded=0;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ctr-admin" target="ctr-keycloak"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="ctr-mobile" value="&lt;b style=&quot;font-size:14px&quot;&gt;Customer app&lt;/b&gt;&lt;br&gt;[Container: Expo, TypeScript]&lt;br&gt;&lt;br&gt;Lets the customer manage the household, the subscription and the orders. Runs on Android" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontSize=12;fontFamily=Arial;fontColor=#ffffff;align=center;spacing=6;fillColor=#23A2D9;strokeColor=#0E7DAD;" vertex="1" parent="ctr-boundary"><mxGeometry x="10" y="45" width="190" height="150" as="geometry"/></mxCell>
        <mxCell id="ctr-adminpanel" value="&lt;b style=&quot;font-size:14px&quot;&gt;Admin panel&lt;/b&gt;&lt;br&gt;[Container: React, Vite]&lt;br&gt;&lt;br&gt;Single-page app in the browser for package types and sending orders. Served by nginx" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontSize=12;fontFamily=Arial;fontColor=#ffffff;align=center;spacing=6;fillColor=#23A2D9;strokeColor=#0E7DAD;" vertex="1" parent="ctr-boundary"><mxGeometry x="570" y="45" width="190" height="150" as="geometry"/></mxCell>
        <mxCell id="ctr-api" value="&lt;b style=&quot;font-size:14px&quot;&gt;Web API&lt;/b&gt;&lt;br&gt;[Container: ASP.NET Core, .NET 10]&lt;br&gt;&lt;br&gt;Holds the business rules and exposes them as a REST API, described by an OpenAPI document" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontSize=12;fontFamily=Arial;fontColor=#ffffff;align=center;spacing=6;fillColor=#23A2D9;strokeColor=#0E7DAD;" vertex="1" parent="ctr-boundary"><mxGeometry x="275" y="245" width="220" height="150" as="geometry"/></mxCell>
        <mxCell id="ctr-db" value="&lt;b style=&quot;font-size:14px&quot;&gt;Database&lt;/b&gt;&lt;br&gt;[Container: SQL Server]&lt;br&gt;&lt;br&gt;Stores customers, items and subscriptions" style="shape=cylinder3;size=12;boundedLbl=1;html=1;whiteSpace=wrap;fontSize=12;fontFamily=Arial;fontColor=#ffffff;align=center;fillColor=#23A2D9;strokeColor=#0E7DAD;" vertex="1" parent="ctr-boundary"><mxGeometry x="285" y="460" width="200" height="115" as="geometry"/></mxCell>
        <mxCell id="ctr-e3" value="Manages household,&lt;br&gt;subscription and orders using" style="endArrow=blockThin;endFill=1;endSize=10;html=1;fontSize=12;fontFamily=Arial;fontColor=#404040;strokeColor=#828282;labelBackgroundColor=#ffffff;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ctr-customer" target="ctr-mobile"><mxGeometry relative="1" as="geometry" x="-0.5"></mxGeometry></mxCell>
        <mxCell id="ctr-e4" value="Maintains package types&lt;br&gt;and sends orders using&lt;br&gt;&lt;i&gt;[web browser]&lt;/i&gt;" style="endArrow=blockThin;endFill=1;endSize=10;html=1;fontSize=12;fontFamily=Arial;fontColor=#404040;strokeColor=#828282;labelBackgroundColor=#ffffff;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ctr-admin" target="ctr-adminpanel"><mxGeometry relative="1" as="geometry" x="-0.45"></mxGeometry></mxCell>
        <mxCell id="ctr-e5" value="Gets access tokens&lt;br&gt;&lt;i&gt;[OpenID Connect, PKCE]&lt;/i&gt;" style="endArrow=blockThin;endFill=1;endSize=10;html=1;fontSize=12;fontFamily=Arial;fontColor=#404040;strokeColor=#828282;labelBackgroundColor=#ffffff;rounded=0;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0.075;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="ctr-mobile" target="ctr-keycloak"><mxGeometry relative="1" as="geometry" x="0"><Array as="points"><mxPoint x="300" y="367"/></Array></mxGeometry></mxCell>
        <mxCell id="ctr-e6" value="Gets access tokens&lt;br&gt;&lt;i&gt;[OpenID Connect, PKCE]&lt;/i&gt;" style="endArrow=blockThin;endFill=1;endSize=10;html=1;fontSize=12;fontFamily=Arial;fontColor=#404040;strokeColor=#828282;labelBackgroundColor=#ffffff;rounded=0;edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.25;exitDx=0;exitDy=0;entryX=0.925;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="ctr-adminpanel" target="ctr-keycloak"><mxGeometry relative="1" as="geometry" x="0"><Array as="points"><mxPoint x="470" y="367"/></Array></mxGeometry></mxCell>
        <mxCell id="ctr-e7" value="Validates tokens with&lt;br&gt;Keycloak&#x27;s signing keys&lt;br&gt;&lt;i&gt;[OpenID Connect, JWT]&lt;/i&gt;" style="endArrow=blockThin;endFill=1;endSize=10;html=1;fontSize=12;fontFamily=Arial;fontColor=#404040;strokeColor=#828282;labelBackgroundColor=#ffffff;rounded=0;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="ctr-api" target="ctr-keycloak"><mxGeometry relative="1" as="geometry" x="-0.45"></mxGeometry></mxCell>
