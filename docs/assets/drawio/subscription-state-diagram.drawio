<mxfile host="drawio-skill"><diagram id="subscription-state-diagram" name="subscription-state-diagram"><mxGraphModel dx="1000" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="init" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="285" y="0" width="30" height="30" as="geometry"/></mxCell><mxCell id="planned" value="&lt;b&gt;Order planned&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;div style=&quot;text-align:left;&quot;&gt;entry / Order created with PlannedAt = now&lt;br/&gt;shown in the admin panel's dispatch queue&lt;/div&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Arial;fontSize=12;" vertex="1" parent="1"><mxGeometry x="170" y="80" width="260" height="76" as="geometry"/></mxCell><mxCell id="sent" value="&lt;b&gt;Order sent&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;div style=&quot;text-align:left;&quot;&gt;entry / SentAt = now&lt;br/&gt;ExpiresAt = SentAt + 1 year&lt;/div&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Arial;fontSize=12;" vertex="1" parent="1"><mxGeometry x="170" y="250" width="260" height="76" as="geometry"/></mxCell><mxCell id="paused" value="&lt;b&gt;Paused&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;div style=&quot;text-align:left;&quot;&gt;no next order is planned&lt;/div&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Arial;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="165" width="200" height="60" as="geometry"/></mxCell><mxCell id="note" value="Version 1.0 has no endpoint that pauses a subscription, so Paused is only reached in the domain tests." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=6;fontFamily=Arial;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="285" width="260" height="60" as="geometry"/></mxCell><mxCell id="s0" value="Start(customerId, startedAt, lines)&lt;br/&gt;[at least one line, no duplicate package type]" style="endArrow=open;endFill=0;html=1;rounded=0;fontFamily=Arial;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="init" target="planned"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s1" value="MarkAsSent(sentAt)&lt;br/&gt;[administrator, POST /shipment]" style="endArrow=open;endFill=0;html=1;rounded=0;fontFamily=Arial;fontSize=12;exitX=0.6;exitY=1;entryX=0.6;entryY=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="planned" target="sent"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s2" value="PlanNextOrder(now)&lt;br/&gt;[now &amp;gt;= ExpiresAt - 14 days,&lt;br/&gt;checked every 5 min by NextOrderPlanner]" style="endArrow=open;endFill=0;html=1;rounded=0;fontFamily=Arial;fontSize=12;exitX=0;exitY=0.5;entryX=0;entryY=0.5;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="sent" target="planned"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="-100" y="288"/><mxPoint x="-100" y="118"/></Array></mxGeometry></mxCell><mxCell id="s3" value="Pause()" style="endArrow=open;endFill=0;html=1;rounded=0;fontFamily=Arial;fontSize=12;exitX=1;exitY=0.25;entryX=0;entryY=0.75;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="sent" target="paused"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s4" value="Pause()" style="endArrow=open;endFill=0;html=1;rounded=0;fontFamily=Arial;fontSize=12;exitX=1;exitY=0.75;entryX=0;entryY=0.25;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="planned" target="paused"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>
