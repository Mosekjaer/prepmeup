<mxfile host="Electron" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) draw.io/26.0.0" version="26.0.0">
  <diagram id="keycloak-login-sequence" name="1. Sequence diagram (OIDC with PKCE)">
    <mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
<mxCell id="title_banner" value="&lt;font color=&quot;#ffffff&quot;&gt;&lt;b style=&quot;font-size: 20px;&quot;&gt;Keycloak Login Flow &amp;#x2014; OpenID Connect (OIDC) with PKCE&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 13px; color: #94A3B8;&quot;&gt;PrepMeUp: authorization code flow between the client (customer app or admin panel) and Keycloak (realm: prepmeup)&lt;/span&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#0F172A;arcSize=6;align=left;spacingLeft=25;" vertex="1" parent="1">
      <mxGeometry x="40" y="30" width="1380" height="70" as="geometry" />
    </mxCell>
<mxCell id="phase_0" value="" style="swimlane;startSize=26;container=1;pointerEvents=0;collapsible=0;rounded=1;arcSize=6;fillColor=#F0F7FF;strokeColor=#B3D7FF;strokeWidth=1;dashed=1;opacity=60;fontFamily=Arial;fontSize=11;fontColor=#B3D7FF;" vertex="1" parent="1">
          <mxGeometry x="50" y="215" width="980" height="225" as="geometry" />
        </mxCell>
        <mxCell id="phase_0_lbl" value="&lt;b&gt;PHASE 1: Authorization request with PKCE&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=10;fontColor=#475569;fontSize=11;fontFamily=Arial;" vertex="1" parent="phase_0">
          <mxGeometry x="5" y="0" width="600" height="26" as="geometry" />
        </mxCell>
<mxCell id="phase_1" value="" style="swimlane;startSize=26;container=1;pointerEvents=0;collapsible=0;rounded=1;arcSize=6;fillColor=#FAF5FF;strokeColor=#D8B4FE;strokeWidth=1;dashed=1;opacity=60;fontFamily=Arial;fontSize=11;fontColor=#D8B4FE;" vertex="1" parent="1">
          <mxGeometry x="50" y="455" width="980" height="260" as="geometry" />
        </mxCell>
        <mxCell id="phase_1_lbl" value="&lt;b&gt;PHASE 2: The user signs in at Keycloak (in the browser)&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=10;fontColor=#475569;fontSize=11;fontFamily=Arial;" vertex="1" parent="phase_1">
          <mxGeometry x="5" y="0" width="600" height="26" as="geometry" />
        </mxCell>
<mxCell id="phase_2" value="" style="swimlane;startSize=26;container=1;pointerEvents=0;collapsible=0;rounded=1;arcSize=6;fillColor=#FFFBEB;strokeColor=#FDE68A;strokeWidth=1;dashed=1;opacity=60;fontFamily=Arial;fontSize=11;fontColor=#FDE68A;" vertex="1" parent="1">
          <mxGeometry x="50" y="730" width="980" height="340" as="geometry" />
        </mxCell>
        <mxCell id="phase_2_lbl" value="&lt;b&gt;PHASE 3: Code exchange, PKCE check and tokens&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=10;fontColor=#475569;fontSize=11;fontFamily=Arial;" vertex="1" parent="phase_2">
          <mxGeometry x="5" y="0" width="600" height="26" as="geometry" />
        </mxCell>
<mxCell id="ll_user" value="User&#10;&lt;span style=&quot;font-size:10px;font-weight:normal;color:#555;&quot;&gt;(customer or administrator)&lt;/span&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;participant=umlActor;verticalAlign=bottom;spacingBottom=-12;labelBackgroundColor=#ffffff;fillColor=#ECEFF1;strokeColor=#455A64;strokeWidth=1.5;fontFamily=Arial;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="125" width="140" height="950" as="geometry" />
        </mxCell>
<mxCell id="ll_app" value="PrepMeUp client&#10;&lt;span style=&quot;font-size:10px;font-weight:normal;color:#1565C0;&quot;&gt;(customer app or admin panel)&lt;/span&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;fontFamily=Arial;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="420" y="125" width="190" height="950" as="geometry" />
        </mxCell>
<mxCell id="ll_kc" value="Keycloak&#10;&lt;span style=&quot;font-size:10px;font-weight:normal;color:#6A1B9A;&quot;&gt;(identity provider, realm: prepmeup)&lt;/span&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;fillColor=#F3E5F5;strokeColor=#6A1B9A;strokeWidth=1.5;fontFamily=Arial;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="780" y="125" width="200" height="950" as="geometry" />
        </mxCell>
<mxCell id="act_user_1" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1;" vertex="1" parent="ll_user">
          <mxGeometry x="64" y="125" width="12" height="35" as="geometry" />
        </mxCell>
<mxCell id="act_app_1" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1;" vertex="1" parent="ll_app">
          <mxGeometry x="89" y="125" width="12" height="140" as="geometry" />
        </mxCell>
<mxCell id="act_kc_1" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1;" vertex="1" parent="ll_kc">
          <mxGeometry x="94" y="235" width="12" height="220" as="geometry" />
        </mxCell>
<mxCell id="act_user_2" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1;" vertex="1" parent="ll_user">
          <mxGeometry x="64" y="425" width="12" height="35" as="geometry" />
        </mxCell>
<mxCell id="act_app_2" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1;" vertex="1" parent="ll_app">
          <mxGeometry x="89" y="635" width="12" height="290" as="geometry" />
        </mxCell>
<mxCell id="act_kc_2" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1;" vertex="1" parent="ll_kc">
          <mxGeometry x="94" y="730" width="12" height="120" as="geometry" />
        </mxCell>
<mxCell id="m1" value="1. User clicks 'Sign in'" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontFamily=Arial;fontSize=11;fontColor=#0F172A;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="150" y="260" as="sourcePoint" />
            <mxPoint x="515" y="260" as="targetPoint" />
          </mxGeometry>
        </mxCell>
<mxCell id="m2_self" value="2. Generate code_verifier, code_challenge (S256) and state" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontFamily=Arial;fontSize=11;fontColor=#0F172A;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="515" y="280" as="sourcePoint" />
            <mxPoint x="515" y="320" as="targetPoint" />
            <Array as="points">
              <mxPoint x="555" y="280" />
              <mxPoint x="555" y="320" />
            </Array>
          </mxGeometry>
        </mxCell>
<mxCell id="m3" value="3. GET /protocol/openid-connect/auth (client_id, redirect_uri, code_challenge, state)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontFamily=Arial;fontSize=11;fontColor=#0F172A;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="515" y="360" as="sourcePoint" />
            <mxPoint x="880" y="360" as="targetPoint" />
          </mxGeometry>
        </mxCell>
<mxCell id="m4" value="4. Show the Keycloak login page in the browser" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#475569;strokeWidth=1.5;fontFamily=Arial;fontSize=11;fontColor=#1E293B;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="880" y="510" as="sourcePoint" />
            <mxPoint x="150" y="510" as="targetPoint" />
          </mxGeometry>
        </mxCell>
<mxCell id="m5" value="5. Enter e-mail and password" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontFamily=Arial;fontSize=11;fontColor=#0F172A;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="150" y="550" as="sourcePoint" />
            <mxPoint x="880" y="550" as="targetPoint" />
          </mxGeometry>
        </mxCell>
<mxCell id="m6_self" value="6. Check the credentials and load realm roles" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontFamily=Arial;fontSize=11;fontColor=#0F172A;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="880" y="590" as="sourcePoint" />
            <mxPoint x="880" y="630" as="targetPoint" />
            <Array as="points">
              <mxPoint x="920" y="590" />
              <mxPoint x="920" y="630" />
            </Array>
          </mxGeometry>
        </mxCell>
<mxCell id="m7_self" value="7. Create SSO session and issue a one-time authorization code" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontFamily=Arial;fontSize=11;fontColor=#0F172A;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="880" y="650" as="sourcePoint" />
            <mxPoint x="880" y="686" as="targetPoint" />
            <Array as="points">
              <mxPoint x="920" y="650" />
              <mxPoint x="920" y="686" />
            </Array>
          </mxGeometry>
        </mxCell>
<mxCell id="m8" value="8. Redirect to redirect_uri?code=...&amp;state=..." style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#475569;strokeWidth=1.5;fontFamily=Arial;fontSize=11;fontColor=#1E293B;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="880" y="780" as="sourcePoint" />
            <mxPoint x="515" y="780" as="targetPoint" />
          </mxGeometry>
        </mxCell>
<mxCell id="m9_self" value="9. Check that state matches the stored value" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontFamily=Arial;fontSize=11;fontColor=#0F172A;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="515" y="795" as="sourcePoint" />
            <mxPoint x="515" y="831" as="targetPoint" />
            <Array as="points">
              <mxPoint x="555" y="795" />
              <mxPoint x="555" y="831" />
            </Array>
          </mxGeometry>
        </mxCell>
<mxCell id="m10" value="10. POST /protocol/openid-connect/token (code, code_verifier, client_id, redirect_uri)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontFamily=Arial;fontSize=11;fontColor=#0F172A;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="515" y="855" as="sourcePoint" />
            <mxPoint x="880" y="855" as="targetPoint" />
          </mxGeometry>
        </mxCell>
<mxCell id="m11_self" value="11. Check SHA256(code_verifier) = code_challenge" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontFamily=Arial;fontSize=11;fontColor=#0F172A;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="880" y="895" as="sourcePoint" />
            <mxPoint x="880" y="931" as="targetPoint" />
            <Array as="points">
              <mxPoint x="920" y="895" />
              <mxPoint x="920" y="931" />
            </Array>
          </mxGeometry>
        </mxCell>
<mxCell id="m12" value="12. Return access token (JWT), ID token and refresh token" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#475569;strokeWidth=1.5;fontFamily=Arial;fontSize=11;fontColor=#1E293B;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="880" y="955" as="sourcePoint" />
            <mxPoint x="515" y="955" as="targetPoint" />
          </mxGeometry>
        </mxCell>
<mxCell id="m13_self" value="13. Store the tokens and update the auth state" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;strokeColor=#1E293B;strokeWidth=1.5;fontFamily=Arial;fontSize=11;fontColor=#0F172A;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="515" y="995" as="sourcePoint" />
            <mxPoint x="515" y="1035" as="targetPoint" />
            <Array as="points">
              <mxPoint x="555" y="995" />
              <mxPoint x="555" y="1035" />
            </Array>
          </mxGeometry>
        </mxCell>
<mxCell id="m14" value="14. Signed in: show the start screen" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#475569;strokeWidth=1.5;fontFamily=Arial;fontSize=11;fontColor=#1E293B;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="515" y="1045" as="sourcePoint" />
            <mxPoint x="150" y="1045" as="targetPoint" />
          </mxGeometry>
        </mxCell>
<mxCell id="note_pkce" value="&lt;b style=&quot;color:#B45309;&quot;&gt;PKCE and state:&lt;/b&gt;&lt;br&gt;Both clients are public clients without a &lt;i&gt;client_secret&lt;/i&gt;. PKCE (RFC 7636) binds the code to the &lt;i&gt;code_verifier&lt;/i&gt;, which only the client knows, so a stolen code cannot be exchanged. The &lt;i&gt;state&lt;/i&gt; value lets the client reject a callback it did not ask for (CSRF)." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacing=8;fillColor=#FFF9C4;strokeColor=#D97706;strokeWidth=1;fontFamily=Arial;fontSize=10;fontColor=#78350F;" vertex="1" parent="1">
          <mxGeometry x="1120" y="240" width="300" height="125" as="geometry" />
        </mxCell>
<mxCell id="note_state" value="&lt;b style=&quot;color:#B45309;&quot;&gt;The two clients:&lt;/b&gt;&lt;br&gt;Customer app: client_id &lt;i&gt;prepmeup-mobile&lt;/i&gt;, redirect_uri &lt;i&gt;prepmeup://auth/callback&lt;/i&gt; (expo-auth-session).&lt;br&gt;Admin panel: client_id &lt;i&gt;prepmeup-admin&lt;/i&gt;, redirect_uri is the panel's own address (react-oidc-context). New customers can register on the login page." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacing=8;fillColor=#FFF9C4;strokeColor=#D97706;strokeWidth=1;fontFamily=Arial;fontSize=10;fontColor=#78350F;" vertex="1" parent="1">
          <mxGeometry x="1120" y="480" width="300" height="125" as="geometry" />
        </mxCell>
<mxCell id="note_jwt" value="&lt;b style=&quot;color:#B45309;&quot;&gt;Tokens:&lt;/b&gt;&lt;br&gt;Keycloak signs the tokens (RS256). The access token has the audience &lt;i&gt;prepmeup-api&lt;/i&gt; and the realm roles.&lt;br&gt;Customer app: access token in memory, refresh token in &lt;i&gt;expo-secure-store&lt;/i&gt;.&lt;br&gt;Admin panel: tokens in memory only, renewed silently." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacing=8;fillColor=#FFF9C4;strokeColor=#D97706;strokeWidth=1;fontFamily=Arial;fontSize=10;fontColor=#78350F;" vertex="1" parent="1">
          <mxGeometry x="1120" y="780" width="300" height="125" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="keycloak-login-flowchart" name="2. Flowchart">
    <mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
<mxCell id="fc_title_banner" value="&lt;font color=&quot;#ffffff&quot;&gt;&lt;b style=&quot;font-size: 20px;&quot;&gt;Keycloak Login Flowchart &amp;#x2014; Activities and Decisions&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 13px; color: #94A3B8;&quot;&gt;Login with PKCE: redirect to Keycloak, sign-in and token exchange&lt;/span&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#020617;arcSize=6;align=left;spacingLeft=25;" vertex="1" parent="1">
      <mxGeometry x="40" y="30" width="1060" height="70" as="geometry" />
    </mxCell>
<mxCell id="lane_client" value="PrepMeUp client (customer app or admin panel)" style="swimlane;startSize=32;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;fontFamily=Arial;fontSize=12;fontStyle=1;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="40" y="125" width="500" height="970" as="geometry" />
        </mxCell>
<mxCell id="lane_kc" value="Keycloak (realm: prepmeup)" style="swimlane;startSize=32;fillColor=#FAF5FF;strokeColor=#E9D5FF;strokeWidth=1.5;fontFamily=Arial;fontSize=12;fontStyle=1;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="580" y="125" width="520" height="970" as="geometry" />
        </mxCell>
<mxCell id="node_start" value="1. Start: user clicks&#10;'Sign in'" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontFamily=Arial;fontSize=11;fontStyle=1;" vertex="1" parent="lane_client">
          <mxGeometry x="160" y="45" width="180" height="45" as="geometry" />
        </mxCell>
<mxCell id="node_pkce_gen" value="2. Generate PKCE and state:&#10;• code_verifier (random)&#10;• code_challenge = SHA256(code_verifier)&#10;• random state value" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;fontFamily=Arial;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="lane_client">
          <mxGeometry x="120" y="115" width="260" height="65" as="geometry" />
        </mxCell>
<mxCell id="node_open_browser" value="3. Open the Keycloak login page&#10;with client_id, redirect_uri,&#10;code_challenge and state" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;fontFamily=Arial;fontSize=11;" vertex="1" parent="lane_client">
          <mxGeometry x="125" y="210" width="250" height="55" as="geometry" />
        </mxCell>
<mxCell id="node_client_callback" value="8. Receive the redirect&#10;and read code and state" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;fontFamily=Arial;fontSize=11;" vertex="1" parent="lane_client">
          <mxGeometry x="125" y="545" width="250" height="55" as="geometry" />
        </mxCell>
<mxCell id="node_client_dec_state" value="9. Does state match&#10;the stored value?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontFamily=Arial;fontSize=10;fontStyle=1;" vertex="1" parent="lane_client">
          <mxGeometry x="145" y="630" width="210" height="70" as="geometry" />
        </mxCell>
<mxCell id="node_client_err_csrf" value="Stop the login&#10;(no token request)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontFamily=Arial;fontSize=10;" vertex="1" parent="lane_client">
          <mxGeometry x="10" y="642" width="110" height="46" as="geometry" />
        </mxCell>
<mxCell id="node_client_post_token" value="10. POST /token&#10;with code and code_verifier" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;fontFamily=Arial;fontSize=11;" vertex="1" parent="lane_client">
          <mxGeometry x="125" y="730" width="250" height="55" as="geometry" />
        </mxCell>
<mxCell id="node_client_save_token" value="13. Store the tokens and&#10;update the auth state" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;fontFamily=Arial;fontSize=11;" vertex="1" parent="lane_client">
          <mxGeometry x="125" y="825" width="250" height="55" as="geometry" />
        </mxCell>
<mxCell id="node_client_finish" value="14. End: the user&#10;is signed in" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontFamily=Arial;fontSize=11;fontStyle=1;" vertex="1" parent="lane_client">
          <mxGeometry x="140" y="905" width="220" height="45" as="geometry" />
        </mxCell>
<mxCell id="node_kc_display" value="4. Show the Keycloak login page&#10;(e-mail and password)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7E22CE;fontFamily=Arial;fontSize=11;" vertex="1" parent="lane_kc">
          <mxGeometry x="135" y="210" width="250" height="55" as="geometry" />
        </mxCell>
<mxCell id="node_kc_submit" value="5. User enters e-mail and password&#10;and submits the form" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7E22CE;fontFamily=Arial;fontSize=11;" vertex="1" parent="lane_kc">
          <mxGeometry x="135" y="295" width="250" height="50" as="geometry" />
        </mxCell>
<mxCell id="node_kc_dec_creds" value="6. Are e-mail and&#10;password correct?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontFamily=Arial;fontSize=10;fontStyle=1;" vertex="1" parent="lane_kc">
          <mxGeometry x="155" y="370" width="210" height="70" as="geometry" />
        </mxCell>
<mxCell id="node_kc_err_creds" value="Show an error&#10;on the login page" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontFamily=Arial;fontSize=10;" vertex="1" parent="lane_kc">
          <mxGeometry x="395" y="382" width="115" height="46" as="geometry" />
        </mxCell>
