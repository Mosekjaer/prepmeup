          <mxGeometry x="35" y="535" width="240" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c_check" value="Check email and password;&lt;br&gt;required action is pending:&lt;br&gt;show form for a new password" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7E22CE;fontFamily=Arial;fontSize=11;" vertex="1" parent="lane_kc">
          <mxGeometry x="35" y="685" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c_save" value="Save new password,&lt;br&gt;remove required action&lt;br&gt;and redirect with authorization code" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7E22CE;fontFamily=Arial;fontSize=11;" vertex="1" parent="lane_kc">
