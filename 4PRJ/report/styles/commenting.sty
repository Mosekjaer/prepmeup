
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% some commands for commenting
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\newif\ifcomments %
\commentstrue % Comment to disable comments

\newcommand{\phm}[1]{%
  \ifcomments%
    \textit{\textbf{\small{\textcolor{purple}{[PHM: #1]}}}}
  \else%
    %
  \fi%
}

\newcommand{\sha}[1]{%
  \ifcomments%
    \textit{\textbf{\small{\textcolor{red}{[SHA: #1]}}}}
  \else%
    %
  \fi%
}


\newcommand*\emptycirc[1][1ex]{\tikz\draw (0,0) circle (#1);} 
\newcommand*\halfcirc[1][1ex]{%
  \begin{tikzpicture}
  \draw[fill] (0,0)-- (90:#1) arc (90:270:#1) -- cycle ;
  \draw (0,0) circle (#1);
  \end{tikzpicture}}
\newcommand*\fullcirc[1][1ex]{\tikz\fill (0,0) circle (#1);} 


% Control Meta text in document
% https://gist.github.com/asalt/c6ef6af36a379c187e08
\usepackage{comment} % to exclude whole sections when I want to

\newif\ifshow % toggle true or false based on if want to hide section
\showtrue % show the sections
%\showfalse % hide the sections

\ifshow
  \includecomment{blockcomment}
\else
  \excludecomment{blockcomment} % anything wrapped in a {wrap} environment will be excluded
\fi


\newif\ifshowmetatext % toggle true or false based on if want to hide section
\showmetatexttrue % show meta text, comment to hide

\ifshowmetatext
  \includecomment{metatext}
\else
  \excludecomment{metatext} % anything wrapped in a {metatext} environment will be excluded
\fi