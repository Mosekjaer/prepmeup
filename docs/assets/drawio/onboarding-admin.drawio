        </mxCell>
        <mxCell id="w_ping" value="AuthGate calls adminClient.ping()&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#15803D;&quot;&gt;(GET /admin/ping • Authorization: Bearer)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#15803D;fontFamily=Arial;fontSize=11;" vertex="1" parent="lane_web">
          <mxGeometry x="35" y="1080" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="w_policy" value="AdminOnly policy:&lt;br&gt;does the token have 'admin'?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontFamily=Arial;fontSize=10;fontStyle=1;" vertex="1" parent="lane_web">
          <mxGeometry x="70" y="1145" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="w_ok" value="200 OK: show dashboard&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#15803D;&quot;&gt;(new admin is onboarded)&lt;/span&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontFamily=Arial;fontSize=11;fontStyle=1;fontSize=10;" vertex="1" parent="lane_web">
