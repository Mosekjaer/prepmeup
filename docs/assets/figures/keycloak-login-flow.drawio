<mxCell id="title_banner" value="&lt;font color=&quot;#ffffff&quot;&gt;&lt;b style=&quot;font-size: 20px;&quot;&gt;Keycloak Login Flow &amp;#x2014; OpenID Connect (OIDC) &amp;amp; PKCE&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 13px; color: #94A3B8;&quot;&gt;PrepMeUp Systemarkitektur: Autentificeringsflow mellem Mobil Klient / Web og Keycloak IdP (Realm: prepmeup)&lt;/span&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#0F172A;arcSize=6;align=left;spacingLeft=25;" vertex="1" parent="1">
