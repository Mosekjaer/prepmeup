<mxfile host="drawio-skill"><diagram id="pipeline-flow" name="pipeline-flow"><mxGraphModel dx="1000" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="devpush" value="Developer pushes a branch" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#e6eeeb;strokeColor=#1f2d2a;fontColor=#1f2d2a;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="370" y="15" width="220" height="50" as="geometry"/></mxCell><mxCell id="ci" value="CI builds and tests backend and clients.&lt;br&gt;Conventions check on branch and PR title" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f2d2a;fontColor=#1f2d2a;fontSize=12;" vertex="1" parent="1"><mxGeometry x="350" y="125" width="260" height="60" as="geometry"/></mxCell><mxCell id="ok" value="Checks green&lt;br&gt;and reviewed?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f2d2a;fontColor=#1f2d2a;fontSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="220" width="200" height="100" as="geometry"/></mxCell><mxCell id="fix" value="Fix on the branch" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f2d2a;fontColor=#1f2d2a;fontSize=12;" vertex="1" parent="1"><mxGeometry x="690" y="240" width="260" height="60" as="geometry"/></mxCell><mxCell id="merge" value="Squash merge to main" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f2d2a;fontColor=#1f2d2a;fontSize=12;" vertex="1" parent="1"><mxGeometry x="350" y="355" width="260" height="60" as="geometry"/></mxCell><mxCell id="cimain" value="CI builds and tests again on main" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f2d2a;fontColor=#1f2d2a;fontSize=12;" vertex="1" parent="1"><mxGeometry x="350" y="470" width="260" height="60" as="geometry"