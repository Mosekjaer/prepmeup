<mxfile host="Electron" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) draw.io/26.0.0" version="26.0.0">
  <diagram id="get-items-flow" name="GET /items Flow">
    <mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="1050" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
<mxCell id="title" value="&lt;font color=&quot;#ffffff&quot;&gt;&lt;b style=&quot;font-size: 20px;&quot;&gt;GET /items &amp;#x2014; A Request Through the Layers&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 13px; color: #94A3B8;&quot;&gt;From the customer app through JWT validation, controller, application service and repository to SQL Server&lt;/span&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#020617;arcSize=6;align=left;spacingLeft=25;" vertex="1" parent="1">
      <mxGeometry x="40" y="30" width="1360" height="70" as="geometry" />
    </mxCell>
<mxCell id="lane_client" value="Customer app (Expo)" style="swimlane;startSize=32;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;fontFamily=Arial;fontSize=12;fontStyle=1;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="40" y="125" width="320" height="760" as="geometry" />
        </mxCell>
<mxCell id="lane_api" value="PrepMeUp.Api (middleware and controller)" style="swimlane;startSize=32;fillColor=#F0FDF4;strokeColor=#BBF7D0;strokeWidth=1.5;fontFamily=Arial;fontSize=12;fontStyle=1;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="380" y="125" width="380" height="760" as="geometry" />
        </mxCell>
<mxCell id="lane_app" value="PrepMeUp.Application" style="swimlane;startSize=32;fillColor=#EEF2FF;strokeColor=#C7D2FE;strokeWidth=1.5;fontFamily=Arial;fontSize=12;fontStyle=1;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="780" y="125" width="310" height="760" as="geometry" />
        </mxCell>
<mxCell id="lane_db" value="PrepMeUp.Infrastructure and SQL Server" style="swimlane;startSize=32;fillColor=#FFFBEB;strokeColor=#FDE68A;strokeWidth=1.5;fontFamily=Arial;fontSize=12;fontStyle=1;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="1110" y="125" width="290" height="760" as="geometry" />
        </mxCell>
<mxCell id="c_start" value="Start: a screen needs the item list&#10;&lt;span style=&quot;font-size:10px;color:#64748B;&quot;&gt;(the second screen in the customer app)&lt;/span&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontFamily=Arial;fontSize=11;fontStyle=1;" vertex="1" parent="lane_client">
          <mxGeometry x="40" y="45" width="240" height="50" as="geometry" />
        </mxCell>
<mxCell id="c_call_items" value="itemsClient.getItems()&#10;&lt;span style=&quot;font-size:10px;color:#15803D;&quot;&gt;GET /items&lt;br&gt;Authorization: Bearer &amp;lt;access token&amp;gt;&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#15803D;fontFamily=Arial;fontSize=11;" vertex="1" parent="lane_client">
          <mxGeometry x="40" y="125" width="240" height="55" as="geometry" />
        </mxCell>
<mxCell id="c_render_ui" value="Receive ItemResponse[]&#10;&lt;span style=&quot;font-size:10px;color:#16A34A;&quot;&gt;(id, name)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;fontFamily=Arial;fontSize=11;" vertex="1" parent="lane_client">
          <mxGeometry x="40" y="600" width="240" height="50" as="geometry" />
        </mxCell>
<mxCell id="c_finish" value="End: the items are&#10;shown on the screen" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontFamily=Arial;fontSize=11;fontStyle=1;" vertex="1" parent="lane_client">
          <mxGeometry x="40" y="690" width="240" height="45" as="geometry" />
        </mxCell>
<mxCell id="a_mw_auth" value="JWT bearer middleware:&#10;read the Bearer token&#10;from the Authorization header" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;fontFamily=Arial;fontSize=10;" vertex="1" parent="lane_api">
          <mxGeometry x="55" y="125" width="270" height="55" as="geometry" />
        </mxCell>
<mxCell id="a_dec_valid" value="Is the JWT valid?&#10;&lt;span style=&quot;font-size:9px;font-weight:normal;color:#D97706;&quot;&gt;(signature via JWKS, issuer, audience, expiry)&lt;/span&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontFamily=Arial;fontSize=10;fontStyle=1;" vertex="1" parent="lane_api">
          <mxGeometry x="50" y="210" width="280" height="76" as="geometry" />
        </mxCell>
<mxCell id="a_err_401" value="&lt;b&gt;401 Unauthorized&lt;/b&gt;&lt;br&gt;Renew the access token with the refresh token and retry once. Still 401: sign out." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontFamily=Arial;fontSize=10;spacing=4;" vertex="1" parent="lane_client">
          <mxGeometry x="40" y="210" width="240" height="70" as="geometry" />
        </mxCell>
<mxCell id="a_ctrl_get" value="ItemsController.GetItems()&#10;[Authorize] passed&#10;calls itemService.GetAllAsync()" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#15803D;fontFamily=Arial;fontSize=10;" vertex="1" parent="lane_api">
          <mxGeometry x="55" y="320" width="270" height="55" as="geometry" />
        </mxCell>
<mxCell id="a_ctrl_res" value="Map each Item to ItemResponse&#10;and return 200 OK with JSON" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontFamily=Arial;fontSize=10;" vertex="1" parent="lane_api">
          <mxGeometry x="55" y="600" width="270" height="50" as="geometry" />
        </mxCell>
<mxCell id="app_service" value="ItemService.GetAllAsync()&#10;calls IItemRepository.GetAllAsync()&#10;&lt;span style=&quot;font-size:10px;font-weight:normal;color:#4338CA;&quot;&gt;(the interface is defined in Application)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4338CA;fontFamily=Arial;fontSize=10;" vertex="1" parent="lane_app">
          <mxGeometry x="35" y="320" width="240" height="55" as="geometry" />
        </mxCell>
<mxCell id="app_return" value="ItemService returns&#10;IReadOnlyList&amp;lt;Item&amp;gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4338CA;fontFamily=Arial;fontSize=10;" vertex="1" parent="lane_app">
          <mxGeometry x="35" y="600" width="240" height="50" as="geometry" />
        </mxCell>
<mxCell id="db_dbcontext" value="PrepMeUpDbContext (EF Core)&#10;translates the LINQ query to SQL" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;fontFamily=Arial;fontSize=10;" vertex="1" parent="lane_db">
          <mxGeometry x="30" y="415" width="230" height="50" as="geometry" />
        </mxCell>
<mxCell id="db_sql_server" value="SQL Server&#10;SELECT [Id], [Name] FROM [Items]" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#FFFFFF;strokeColor=#D97706;fontFamily=Arial;fontSize=10;" vertex="1" parent="lane_db">
          <mxGeometry x="30" y="505" width="230" height="60" as="geometry" />
        </mxCell>
<mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#334155;strokeWidth=1.5;fontFamily=Arial;fontSize=10;fontColor=#0F172A;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c_start" target="c_call_items">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
<mxCell id="e2" value="GET /items" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#334155;strokeWidth=1.5;fontFamily=Arial;fontSize=10;fontColor=#0F172A;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c_call_items" target="a_mw_auth">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
<mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#334155;strokeWidth=1.5;fontFamily=Arial;fontSize=10;fontColor=#0F172A;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="a_mw_auth" target="a_dec_valid">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
<mxCell id="e4_no" value="No (401)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#DC2626;strokeWidth=1.5;fontFamily=Arial;fontSize=10;fontColor=#DC2626;fontStyle=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="a_dec_valid" target="a_err_401">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
<mxCell id="e4_yes" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16A34A;strokeWidth=1.5;fontFamily=Arial;fontSize=10;fontColor=#16A34A;fontStyle=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="a_dec_valid" target="a_ctrl_get">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
<mxCell id="e5" value="GetAllAsync()" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#334155;strokeWidth=1.5;fontFamily=Arial;fontSize=10;fontColor=#0F172A;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="a_ctrl_get" target="app_service">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
<mxCell id="e6" value="IItemRepository" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#334155;strokeWidth=1.5;fontFamily=Arial;fontSize=10;fontColor=#0F172A;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="app_service" target="db_repository">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
<mxCell id="e7" value="SQL query" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#334155;strokeWidth=1.5;fontFamily=Arial;fontSize=10;fontColor=#0F172A;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="db_dbcontext" target="db_sql_server">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
<mxCell id="e8" value="rows as Item entities" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#334155;strokeWidth=1.5;fontFamily=Arial;fontSize=10;fontColor=#0F172A;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="db_sql_server" target="app_return">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
<mxCell id="e9" value="IReadOnlyList&amp;lt;Item&amp;gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#334155;strokeWidth=1.5;fontFamily=Arial;fontSize=10;fontColor=#0F172A;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="app_return" target="a_ctrl_res">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
<mxCell id="e10" value="200 OK (JSON)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#334155;strokeWidth=1.5;fontFamily=Arial;fontSize=10;fontColor=#0F172A;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="a_ctrl_res" target="c_render_ui">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
<mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16A34A;strokeWidth=1.5;fontFamily=Arial;fontSize=10;fontColor=#16A34A;fontStyle=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c_render_ui" target="c_finish">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      <mxCell id="db_repository" value="ItemRepository.GetAllAsync()&#10;&lt;span style=&quot;font-size:10px;font-weight:normal;color:#D97706;&quot;&gt;implements IItemRepository&lt;br&gt;_dbContext.Items.ToListAsync()&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;fontFamily=Arial;fontSize=10;" vertex="1" parent="lane_db"><mxGeometry x="30" y="320" width="230" height="55" as="geometry" /></mxCell><mxCell id="e6b" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#334155;strokeWidth=1.5;fontFamily=Arial;fontSize=10;fontColor=#0F172A;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="db_repository" target="db_dbcontext"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_retry" value="retry" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#334155;strokeWidth=1.5;fontFamily=Arial;fontSize=10;fontColor=#0F172A;exitX=0.5;exitY=0;entryX=0.5;entryY=1;dashed=1;" edge="1" parent="1" source="a_err_401" target="c_call_items"><mxGeometry relative="1" as="geometry" /></mxCell></root>
